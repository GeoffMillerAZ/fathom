+import { ImportedModuleDescriptor, ImportResolver } from 'pyright-internal/analyzer/importResolver';
+import { ImportResult } from 'pyright-internal/analyzer/importResult';
+import { ConfigOptions, ExecutionEnvironment } from 'pyright-internal/common/configOptions';
+import { Host } from 'pyright-internal/common/host';
+import { ServiceProvider } from 'pyright-internal/common/serviceProvider';
+import { Uri } from 'pyright-internal/common/uri/uri';
+import { native_first_module_names, stdlib_module_names } from './hardcoded';
+
+// Pyright 1.1.390 returns stdlib typeshed even when a concrete execution-root
+// module shadows that name at runtime. Restrict the SCIP correction to that
+// observed case. Relative imports, custom stub paths, namespaces, installed
+// packages, and builtin/frozen stdlib modules retain Pyright's resolution.
+export class ProjectFirstImportResolver extends ImportResolver {
+    constructor(serviceProvider: ServiceProvider, private readonly configOptions: ConfigOptions, host: Host) {
+        super(serviceProvider, configOptions, host);
+    }
+
+    override resolveImport(
+        sourceFileUri: Uri,
+        execEnv: ExecutionEnvironment,
+        moduleDescriptor: ImportedModuleDescriptor
+    ): ImportResult {
+        const first = moduleDescriptor.nameParts[0];
+        if (!first || moduleDescriptor.leadingDots !== 0 || !execEnv.root || this.configOptions.stubPath ||
+            !stdlib_module_names.has(first) || native_first_module_names.has(first)) {
+            return super.resolveImport(sourceFileUri, execEnv, moduleDescriptor);
+        }
+
+        const local = this.resolveAbsoluteImport(
+            sourceFileUri,
+            execEnv.root,
+            execEnv,
+            moduleDescriptor,
+            moduleDescriptor.nameParts.join('.'),
+            [],
+            false,
+            false,
+            true,
+            true,
+            false
+        );
+        const firstUri = local.resolvedUris[0];
+        if ((local.isImportFound || local.isPartlyResolved) && !local.isNamespacePackage && !local.isStubPackage && firstUri &&
+            !firstUri.isEmpty() && firstUri.startsWith(execEnv.root) && this.hasRuntimeSource(firstUri)) {
+            // A concrete local top-level module also blocks a nested stdlib
+            // import when the nested name cannot be resolved from that module.
+            return this.filterImplicitImports(local, moduleDescriptor.importedSymbols);
+        }
+        return super.resolveImport(sourceFileUri, execEnv, moduleDescriptor);
+    }
+
+    private hasRuntimeSource(uri: Uri): boolean {
+        if (uri.lastExtension === '.py') return true;
+        return uri.lastExtension === '.pyi' && this.fileSystem.existsSync(uri.replaceExtension('.py'));
+    }
+}
