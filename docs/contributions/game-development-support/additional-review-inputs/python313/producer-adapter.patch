+import { spawnSync } from 'child_process';
+import { generatePackageInfoScript } from './environment';
+
+test('importlib metadata name handles valid, missing, and malformed distributions', () => {
+    const harness = [
+        'import importlib.metadata, json',
+        'class Dist:',
+        '    def __init__(self, metadata):',
+        '        self.metadata, self.version, self.files = metadata, "1.0", []',
+        'scope = {"__name__": "fixture"}',
+        'exec(' + JSON.stringify(generatePackageInfoScript()) + ', scope)',
+        'importlib.metadata.distributions = lambda: [',
+        '    Dist({"Name": "valid-package"}), Dist({}), Dist(None), Dist({"Name": 42}), Dist({"Name": " "})',
+        ']',
+        'print(json.dumps(scope["get_package_info"]({"valid-package"})))',
+    ].join('\n');
+    const result = spawnSync('python3', ['-c', harness], { encoding: 'utf8' });
+    expect(result.status).toBe(0);
+    expect(JSON.parse(result.stdout)).toEqual([{ name: 'valid-package', version: '1.0', files: [] }]);
+});
