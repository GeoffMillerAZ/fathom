+import { Uri } from 'pyright-internal/common/uri/uri';
+import { getFileSpec } from 'pyright-internal/common/uri/uriUtils';
+import { isOwnedProjectSourceUri } from './ProjectOwnership';
+
+const detector = { isCaseSensitive: () => true };
+const root = Uri.file('/fixture/project', detector);
+const exclude = [getFileSpec(root, '**/.*')];
+const local = { isThirdPartyImport: false, isTypeshedFile: false };
+
+test('project source ownership uses normalized URI containment and Pyright classification', () => {
+    expect(isOwnedProjectSourceUri(Uri.file('/fixture/project/pkg/../json.py', detector), root, exclude, local))
+        .toBe(true);
+    expect(isOwnedProjectSourceUri(Uri.file('/fixture/project/pkg/imported.py', detector), root, exclude, local))
+        .toBe(true);
+    expect(isOwnedProjectSourceUri(Uri.file('/fixture/project-other/json.py', detector), root, exclude, local))
+        .toBe(false);
+    expect(isOwnedProjectSourceUri(Uri.file('/fixture/project/.cache/producer/dist/typeshed-fallback/stdlib/xml/__init__.pyi', detector),
+        root, exclude, { isThirdPartyImport: false, isTypeshedFile: true })).toBe(false);
+    expect(isOwnedProjectSourceUri(Uri.file('/fixture/project/.cache/producer/dist/typeshed-fallback/stdlib/xml/__init__.pyi', detector),
+        root, exclude, undefined)).toBe(false);
+    expect(isOwnedProjectSourceUri(Uri.file('/fixture/project/.tools/venv/lib/site-packages/PIL/Image.py', detector),
+        root, exclude, { isThirdPartyImport: true, isTypeshedFile: false })).toBe(false);
+});
diff --git a/packages/pyright-scip/src/ProjectOwnership.ts b/packages/pyright-scip/src/ProjectOwnership.ts
new file mode 100644
index 00000000..ee447787
--- /dev/null
+++ b/packages/pyright-scip/src/ProjectOwnership.ts
@@ -0,0 +1,16 @@
+import { Uri } from 'pyright-internal/common/uri/uri';
+import { FileSpec } from 'pyright-internal/common/uri/uriUtils';
+
+// A URI's physical containment alone does not establish project ownership:
+// this private producer and its bundled typeshed may live below the project
+// root. Keep Pyright's import classification and configured exclusions.
+export function isOwnedProjectSourceUri(
+    uri: Uri,
+    projectRoot: Uri,
+    exclude: FileSpec[],
+    sourceInfo: { isThirdPartyImport: boolean; isTypeshedFile: boolean } | undefined
+): boolean {
+    return uri.startsWith(projectRoot) &&
+        !sourceInfo?.isThirdPartyImport && !sourceInfo?.isTypeshedFile &&
+        !exclude.some((spec) => uri.matchesRegex(spec.regExp));
+}
