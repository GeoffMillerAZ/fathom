+import { CancellationToken, MarkupKind, Position } from 'vscode-languageserver';
+import { Program } from 'pyright-internal/analyzer/program';
+import { HoverProvider, HoverResults } from 'pyright-internal/languageService/hoverProvider';
+import { Uri } from 'pyright-internal/common/uri/uri';
+
+export function getHoverForPosition(
+    program: Program,
+    filePath: Uri,
+    position: Position,
+    format: MarkupKind,
+    token: CancellationToken
+): HoverResults | null {
+    return program.run((view) => new HoverProvider(view, filePath, position, format, token).getHoverResults(), token);
+}
