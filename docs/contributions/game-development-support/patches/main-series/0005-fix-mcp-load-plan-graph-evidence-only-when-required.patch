+// Spec-only rows need indexed symbol names for their matrix, but no graph.
+// They share the snapshot memo and the same bounded wait as the full stage.
+func verifyPlanSnapshotWithDeadline(ctx context.Context, backend QueryInterface, service string) (*verifyStage, error) {
+	return verifyStageWithDeadline(ctx, func(wctx context.Context) (*verifyStage, error) {
+		snap, err := serviceSnapshot(wctx, backend, service)
+		if err != nil {
+			return nil, err
+		}
+		return &verifyStage{nodes: snap.Nodes}, nil
+	})
+}
