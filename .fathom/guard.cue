// .fathom/guard.cue — fathom's own pre-edit guards.
// UI group adapted from app-kit's fathom-pack guard-pack.cue (consumer
// group, v0.1), scoped to this repo's real UI paths; provenance comments
// kept so /fathom:activate can re-sync against the pack.

guards: [
	{
		// from app-kit fathom-pack v0.1 (consumer; scoped for fathom)
		scopes: ["cmd/fathom/observatory*.go", "cmd/fathom/brief.go", "cmd/fathom/statusz.go"]
		note:      "UI markup here is app-kit (D10/D13): search the corpus (appkit MCP search_components) and the kit packages (ui/dashboard, ui/stat, ui/viz) BEFORE writing any markup — a hand-rolled tile set was deleted from this repo the same day it was written (2026-08-08). Role utilities only (bg-surface-raised, text-ink-muted); dark: color variants are DROPPED (tokens carry dark); stat.Absent for uninstrumented metrics — never a fabricated zero (law 3). New render files must be added to cmd/fathom/ui/input.css @source globs or their classes silently never render; then run task ui:css."
		max_rules: 4
	},
	{
		// from app-kit fathom-pack v0.1 (consumer)
		scopes: ["cmd/fathom/ui/**"]
		note:      "cmd/fathom/ui/app.css and tokens/theme.css are GENERATED by task ui:css (the checksum-pinned Tailwind binary) — never hand-edit; edit input.css or the kit tokens and regenerate. The @source globs in input.css are load-bearing: Tailwind only emits utilities it can SEE."
		max_rules: 2
	},
	{
		// from app-kit fathom-pack v0.1 (consumer)
		command_scopes: ["npm *", "npx *", "yarn *", "pnpm *", "bun *"]
		note: "No Node toolchain in this repo (app-kit ADR-0017 §3: fathom's artifact is a Go binary). The observatory CSS builds via task ui:css — the pinned Tailwind standalone binary. If you think you need npm here, re-read cmd/fathom/ui/input.css first."
	},

	// ADR-038 (wave G1): governance that can be compiled to a deterministic
	// pre-write check now bites at the edit, not just advises after it —
	// guards-pilot-8's own reading found the served rule reached the agent
	// on 4 of 8 tasks and was violated anyway. Each guard below maps to one
	// of that reading's eight tasks (testdata/scenariobench/guards-fathom.json);
	// which of the eight this repo can and cannot cover pre-write is
	// recorded in ADR-038 itself — i1 (sorted output) and i11 (a new MCP
	// tool's doc line) have no deterministic pre-write signal and stay
	// gate-only, and i28 (a lenient DuckDB path) is a control-flow decision
	// no structural check here can see either.
	{
		// I19 / ADR-011: no org-specific names, hosts or accounts in a new
		// fixture (guards-i19).
		scopes: ["internal/connector/testdata/**"]
		checks: ["org_token"]
		enforce: true
		note:    "ADR-011 / I19: no third-party or customer org names, hosts, or catalogs in a fixture — even a realistic-sounding placeholder. Use example.com/fauxtown/an RFC 2606 name instead."
	},
	{
		// I31: a new CLI verb's default output path must route through
		// workspacePath()/stateLogPath(), never a hardcoded path outside
		// workspace/ (guards-i31).
		scopes: ["cmd/fathom/*.go"]
		checks: ["workspace_output"]
		enforce: true
		note:    "I31: project-emitted artifacts default to workspace/ (gitignored) — route a new CLI verb's default output path through workspacePath()/stateLogPath() (cmd/fathom/defaultpaths.go), never a hardcoded path outside it."
	},
	{
		// I36: a use-case doc's own "## Maintained" contract line must
		// survive an edit (guards-i36).
		scopes: ["docs/use-cases/*.md"]
		checks: ["usecase_maintained"]
		enforce: true
		note:    "I36: every docs/use-cases/*.md doc keeps its own \"## Maintained\" contract line naming only registered tools and dispatched verbs — TestMaintainedLinesParse is the gate this rule anticipates."
	},
	{
		// I16 / O25: the ACTUAL raw-cp-onto-the-daemon-path command, never
		// only the doc-advice half of guards-i16 (see ADR-038's own note on
		// why the CLAUDE.md-prose scenario stays gate-only via
		// `task config-audit`).
		command_scopes: ["cp * *libexec/fathom/fathom*", "cp * */fathom/fathom"]
		enforce: true
		note:    "O25 / I16: task deploy signs the rebuilt binary, installs it via temp+rename, and asserts the daemon serves HEAD — a raw cp truncates a running executable and loses the fathom-dev TCC grant. Run task deploy instead."
	},
]

// fathom's own first compiled governance rules (VB-13, docs/vision/29-
// verbs-not-lookups.md §3 wave C; ADR-035 decision 3) — `fathom rules
// gen-test --out rules` compiles these to rules/layer_rules_test.go
// (VB-14), so the same three sentences below fail `task validate` and CI
// on an actual regression, not just an agent's edit. Package identity is
// the repo-relative DIRECTORY ("internal/store"), matching both
// producers: the call-derived index (live obligations serving) and
// go/packages' true import graph (the generated test).
layer_rules: [
	{
		// enforce: true (ADR-038, wave G1) covers guards-i2: a proposed
		// cgo import or build tag under internal/store is denied at the
		// edit (EvaluateLayerRuleEnforcement's cgo_purity scan, keyed off
		// this rule's own `from`), not just advised after it lands.
		id:       "store-no-cgo"
		kind:     "import_direction"
		sentence: "internal/store must not import cgo-backed packages (ADR-020/025: the store stays pure Go; CGO comes only from the tree-sitter extractor bindings, ADR-013)."
		enforce:  true
		from: ["internal/store"]
		to: ["internal/extractor", "internal/extractor/treesitter"]
	},
	{
		id:       "core-no-mcp-or-cmd"
		kind:     "import_direction"
		sentence: "internal/core imports nothing from internal/mcp or cmd/ — the domain model is the keystone (CLAUDE.md), never a consumer of the surfaces built on it."
		from: ["internal/core"]
		to: ["internal/mcp", "cmd/**"]
	},
	{
		id:       "internal-no-cycles"
		kind:     "no_cycles"
		sentence: "no import cycles under internal/ — the connector/fusion/query layering (ADR.md) is acyclic by construction."
		scope: ["internal/**"]
	},
]
