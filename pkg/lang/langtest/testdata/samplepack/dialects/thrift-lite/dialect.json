{
  "id": "thrift-lite",
  "display": "Thrift-lite IDL (.thr)",
  "kind": "language",
  "engine": "tags",
  "lang_tag": "thrift-lite",
  "match": {
    "extensions": [".thr"],
    "basenames": [],
    "globs": [],
    "shebangs": [],
    "sniff": null
  },
  "grammar": { "blob": "thrift", "entry_point": "tree_sitter_thrift" },
  "variants": [],
  "queries": { "tags": "tags.scm" },
  "kinds": {
    "struct":   { "source_kind": "ThriftLiteStruct",   "canonical": "struct",  "container": true },
    "service":  { "source_kind": "ThriftLiteService",  "canonical": "service", "container": true, "callable": true },
    "function": { "source_kind": "ThriftLiteFunction", "canonical": "rpc",     "callable": true }
  },
  "required_kinds": ["struct", "service", "function"],
  "oracle_kinds": {},
  "qualify": { "chain_containers": true, "container_sep": ".", "method_sep": "." },
  "package": { "strategy": "dir" },
  "signature": { "max_chars": 200 },
  "target_level": "L2",
  "queue_id": "thrift-lite"
}
