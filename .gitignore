# Build / test artifacts
*.out
*.test
coverage.*
/dist/
/bin/

# All build artifacts, logs, temp files, and local databases live under workspace/
/workspace/

# DuckDB stray files (if ever written outside workspace/)
*.duckdb
*.duckdb.wal

# Reference clones of external tools (inspiration only; not part of the build)
/ref/

# Conversion scratch (scanned design docs, tiles, recovered transcripts)
/tmp/

# `go mod vendor` output — a consumer's local build artifact (air-gapped
# builds, docs/distribution.md), never committed. third_party/agentic-kit is
# the one private dependency, mirrored in-tree on purpose; it is NOT covered
# by this rule.
/vendor/

# OS
.DS_Store

# Built binary at repo root (module name)
/fathom
