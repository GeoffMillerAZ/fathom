# Build / test artifacts
*.out
*.test
coverage.*
/dist/*
!/dist/agents/
/bin/

# All build artifacts, logs, temp files, and local databases live under workspace/
/workspace/

# DuckDB stray files (if ever written outside workspace/)
*.duckdb
*.duckdb.wal

# Reference clones of external tools (inspiration only; not part of the build)
/ref/

# Conversion scratch (scanned design docs, tiles, recovered transcripts)
/tmp/

# `go mod vendor` output — a consumer's local build artifact (air-gapped
# builds, docs/distribution.md), never committed. third_party/agentic-kit is
# the one private dependency, mirrored in-tree on purpose; it is NOT covered
# by this rule.
/vendor/

# Playwright MCP screenshots — tool state, not source. Left untracked these
# stamp every `go build` as vcs.modified=true, which degrades `doctor`'s
# binary_fresh verdict and makes scripts/migrate-fleet-store.sh refuse to run.
.playwright-mcp/

# OS
.DS_Store

# Built binary at repo root (module name)
/fathom
.claude/worktrees/
.claude/settings.local.json
cmd/fathom/workspace/

# Phase U (internal/wiring): per-repository wiring state. Receipts carry the
# FULL prior content of every file fathom rewrote, so they are local-only by
# construction (law 13) and must never be committed; owned.json is this
# checkout's ownership map, not a shared fact about the project.
.fathom/receipts.jsonl
.fathom/owned.json
# memories.jsonl: per-developer anchored memories with free-form claim text.
# .fathom/ is a git-TRACKED directory, so without this line every adopter's
# memories sit one `git add .` from being published — law 13 makes sharing
# a human verb, and that would make it an accident (review finding W4).
.fathom/memories.jsonl

# go.work is LOCAL DEV ONLY (ADR-019, and the kit's own V1 decision). It was
# committed until 2026-09-01, referencing ../agentic-kit and ../app-kit, and
# a fresh clone therefore could not build at all: "cannot load module
# ../agentic-kit listed in go.work file". It also masked missing go.sum
# entries, so the standalone build was broken and invisible. Create one
# locally when you want to edit fathom and a kit side by side; never commit it.
go.work
go.work.sum


# competitor artifacts written by their own CLIs during bench runs (vision 27 §6)
.serena/
graphify-out/
