# cloud-tools.env — the one place a cloud session's tool pins live
# (docs/adoption/cloud-sessions.md; read by scripts/cloud-setup.sh).
#
# Plain KEY=value lines, no shell expansion, so a generator (env-kit's
# planned agent-cloud substrate, owner decision E2 of 2026-10-02) can write
# this file and any reader can parse it without running it. Go itself is not
# pinned here: go.mod's `go` line is the toolchain, fetched through
# proxy.golang.org by GOTOOLCHAIN=auto. Each tool is built with
# `go install <module>@<version>`, so every download goes through the Go
# module proxy too — no GitHub release asset, no dl.google.com.

# go-task: the Taskfile runner (`task validate` is the gate).
TASK_MODULE=github.com/go-task/task/v3/cmd/task
TASK_VERSION=v3.52.0

# cue: the CUE CLI `task cue-vet` runs; matches go.mod's cuelang.org/go.
CUE_MODULE=cuelang.org/go/cmd/cue
CUE_VERSION=v0.16.1

# lefthook: the git hooks (pre-commit fmt + cue, pre-push validate + verify).
# 1.13.6 is the version lefthook.yml's use_stdin note was measured against.
LEFTHOOK_MODULE=github.com/evilmartians/lefthook
LEFTHOOK_VERSION=v1.13.6
