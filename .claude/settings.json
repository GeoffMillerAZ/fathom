{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/Volumes/m2ext/code/geoffmilleraz/sextant/bin/fathom edit-hook",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/Volumes/m2ext/code/geoffmilleraz/sextant/bin/fathom session-hook",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/Volumes/m2ext/code/geoffmilleraz/sextant/bin/fathom stop-hook",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
