{
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "command": "fathom config audit --hook",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "command": "fathom session-hook --event instructions-loaded",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "fathom edit-hook --pre",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      },
      {
        "hooks": [
          {
            "command": "fathom edit-hook --pre",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  }
}
