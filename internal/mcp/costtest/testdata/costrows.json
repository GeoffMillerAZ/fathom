{
  "_comment": "One cost row per registered MCP tool (design §4.8, RT-93): the arguments the harness calls it with against the generated fleet (\"$service\" is costtest.QueriedService, the same size at 1x and 10x). expect_error names why a call cannot answer on the fixture; such a row still measures what the refusal costs. TestEveryToolHasCostRow fails when a registered tool has no row or a row names no tool.",
  "tools": {
    "arch_conformance": {"args": {"service": "$service"}},
    "batch": {"args": {"calls": [{"tool": "find_symbol", "arguments": {"service": "$service", "name": "Post"}}]}},
    "blast_radius": {"args": {"service": "$service", "changed_files": ["ledger.go"]}},
    "cloc": {"args": {"service": "$service"}},
    "community": {"args": {"service": "$service", "symbol": "Post"}},
    "compile_layer": {"args": {"service": "$service", "dry_run": true}},
    "complexity": {"args": {"service": "$service"}},
    "contradiction_scan": {"args": {"service": "$service", "concern": "ledger"}},
    "cross_repo_callers": {"args": {"symbol": "Post"}},
    "dead_code": {"args": {"service": "$service"}},
    "discoveries": {"args": {"service": "$service"}},
    "evidence_summary": {"args": {"service": "$service"}},
    "find_callers": {"args": {"service": "$service", "symbol": "validateEntry"}},
    "find_symbol": {"args": {"service": "$service", "name": "Post"}},
    "findings_near": {"args": {"service": "$service", "subject": "Post"}},
    "fleet_drift": {"args": {}},
    "god_object": {"args": {"service": "$service"}},
    "history": {"args": {"service": "$service", "symbol": "Post"}},
    "http_client_calls": {"args": {"service": "$service"}},
    "ingest": {"args": {"service": "$service"}},
    "list_services": {"args": {}},
    "localize": {"args": {"service": "$service", "concern": "ledger balance"}},
    "memory_search": {"args": {"service": "$service", "query": "ledger"}},
    "obligations": {"args": {"service": "$service", "file": "ledger.go"}},
    "outline": {"args": {"service": "$service", "file": "ledger.go"}},
    "pack_context": {"args": {"service": "$service", "concern": "ledger"}},
    "proto_conformance": {"args": {"service": "$service"}},
    "query_symbols": {"args": {"service": "$service", "concern": "ledger"}},
    "reachable": {"args": {"service": "$service", "from": "Post", "to": "applyEntry"}},
    "read_source": {"args": {"service": "$service", "file": "ledger.go"}},
    "references": {"args": {"query": "validateEntry", "services": ["$service"]}},
    "remove_service": {"args": {"service": "no-such-service"}, "note": "a service that does not exist: the harness never removes a fleet service it measures other rows against"},
    "rename_impact": {"args": {"service": "$service", "symbol": "validateEntry"}},
    "rename_service": {"args": {"from": "no-such-service", "to": "still-no-such-service"}, "expect_error": "a rename of a service that does not exist: the harness never renames a fleet service it measures other rows against"},
    "repo_map": {"args": {"service": "$service"}},
    "review_diff": {"args": {"service": "$service", "changed_files": ["ledger.go"]}},
    "safe_delete_check": {"args": {"service": "$service", "symbol": "applyEntry"}},
    "search": {"args": {"service": "$service", "pattern": "validateEntry"}},
    "secret_scan": {"args": {"service": "$service"}},
    "shell_out": {"args": {"service": "$service"}},
    "spec_coverage": {"args": {"service": "$service", "spec_ids": ["RT-1"]}},
    "spec_refs": {"args": {"service": "$service"}},
    "stale_docs": {"args": {"service": "$service"}},
    "staleness_report": {"args": {"service": "$service"}},
    "status": {"args": {"section": "sources", "service": "$service"}},
    "symbol_context": {"args": {"service": "$service", "symbol": "Post"}},
    "test_impact": {"args": {"service": "$service", "symbol": "validateEntry"}},
    "traceability": {"args": {"service": "$service"}},
    "traverse": {"args": {"service": "$service", "start": "Post"}},
    "verify_plan": {"args": {"service": "$service", "plan_markdown": "# plan\n\n- [ ] Post exists {id: CT-1, symbol: Post}\n"}}
  }
}
