{
  "decode": "yaml",
  "detect": { "basenames": ["kustomization.yaml", "kustomization.yml"] },
  "entities": [
    { "select": "$.resources[*]", "where": { "is_scalar": true }, "kind": "resource", "source_kind": "KustomizeResource", "name": "$" },
    { "select": "$.bases[*]", "where": { "is_scalar": true }, "kind": "resource", "source_kind": "KustomizeResource", "name": "$" },
    { "select": "$.patchesStrategicMerge[*]", "where": { "is_scalar": true }, "kind": "resource", "source_kind": "KustomizePatch", "name": "$" },
    { "select": "$.patches[*]", "kind": "resource", "source_kind": "KustomizePatch", "name": "$ | .path" },
    { "select": "$.patchesJson6902[*]", "kind": "resource", "source_kind": "KustomizePatch", "name": "$ | .path" },
    { "select": "$.images[*]", "where": { "is_map": true }, "kind": "resource", "source_kind": "KustomizeImage", "name": ".name" }
  ],
  "cross_file": [
    { "select": "$.resources[*]", "value": "$", "resolve": "repo-path", "edge": "includes" },
    { "select": "$.bases[*]", "value": "$", "resolve": "repo-path", "edge": "includes" }
  ]
}
