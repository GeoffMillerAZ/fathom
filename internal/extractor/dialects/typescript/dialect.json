{
  "id": "typescript",
  "display": "TypeScript",
  "kind": "language",
  "engine": "tags",
  "lang_tag": "ts",
  "match": {
    "extensions": [".ts", ".mts", ".cts"],
    "basenames": [],
    "globs": [],
    "shebangs": [],
    "sniff": null
  },
  "grammar": { "blob": "typescript", "entry_point": "tree_sitter_typescript" },
  "variants": [
    { "id": "tsx", "entry_point": "tree_sitter_tsx", "extensions": [".tsx"] }
  ],
  "queries": { "tags": "tags.scm", "imports": "imports.scm", "references": "references.scm" },
  "kinds": {
    "class":     { "source_kind": "JSClass",     "canonical": "class",      "container": true },
    "function":  { "source_kind": "JSFunc",      "canonical": "function",   "callable": true },
    "method":    { "source_kind": "JSMethod",    "canonical": "method",     "callable": true },
    "interface": { "source_kind": "TSInterface", "canonical": "interface", "container": true },
    "type":      { "source_kind": "TSType",      "canonical": "type_alias", "container": true },
    "enum":      { "source_kind": "TSEnum",      "canonical": "enum" },
    "component":       { "source_kind": "JSComponent",      "canonical": "function", "callable": true },
    "class_component": { "source_kind": "JSClassComponent", "canonical": "class",    "container": true },
    "hook":            { "source_kind": "JSHook",           "canonical": "function", "callable": true },
    "prop":            { "source_kind": "JSProp",           "canonical": "field" },
    "module":          { "source_kind": "JSModule",         "canonical": "module" },
    "constant":        { "source_kind": "JSConst",          "canonical": "constant" }
  },
  "required_kinds": ["class", "function", "method", "interface", "enum"],
  "oracle_kinds": {
    "scip":  { "class": "class", "interface": "interface", "type": "type_alias", "enum": "enum",
               "function": "function", "function@scoped": "method", "method": "method",
               "constructor": "method", "get": "method", "set": "method",
               "var": "variable", "const": "variable", "let": "variable",
               "module": "namespace", "property": "property" },
    "ctags": { "class": "class", "function": "function", "generator": "function", "method": "method",
               "interface": "interface", "enum": "enum", "alias": "type_alias", "namespace": "namespace",
               "property": "property", "variable": "variable", "constant": "constant",
               "enumerator": "enum_member" },
    "tool":  { "class_declaration": "class", "abstract_class_declaration": "class",
               "function_declaration": "function", "generator_function_declaration": "function",
               "method_definition": "method", "interface_declaration": "interface",
               "enum_declaration": "enum", "type_alias_declaration": "type_alias",
               "internal_module": "namespace" }
  },
  "qualify": { "chain_containers": false, "container_sep": ".", "method_sep": "." },
  "calls": { "qualify": true },
  "package": { "strategy": "dir" },
  "imports": { "strategy": "relative-path" },
  "signature": { "max_chars": 200 },
  "module_symbol": "module",
  "target_level": "L4",
  "queue_id": "typescript"
}
