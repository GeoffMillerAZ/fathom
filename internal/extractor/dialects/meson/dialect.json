{
  "id": "meson",
  "display": "Meson builds (meson.build, meson.options, meson_options.txt)",
  "kind": "tooling",
  "engine": "tags",
  "lang_tag": "meson",
  "match": {
    "extensions": [],
    "basenames": [
      "meson.build",
      "meson.options",
      "meson_options.txt"
    ],
    "globs": [],
    "shebangs": [],
    "sniff": null
  },
  "grammar": {
    "blob": "meson",
    "entry_point": "tree_sitter_meson"
  },
  "variants": [],
  "queries": {
    "tags": "tags.scm",
    "imports": "imports.scm"
  },
  "kinds": {
    "project": {
      "source_kind": "MesonProject",
      "canonical": "module"
    },
    "target": {
      "source_kind": "MesonTarget",
      "canonical": "target",
      "callable": true
    },
    "variable": {
      "source_kind": "MesonVariable",
      "canonical": "variable_decl"
    },
    "dependency": {
      "source_kind": "MesonDependency",
      "canonical": "import",
      "callable": true
    },
    "subproject": {
      "source_kind": "MesonSubproject",
      "canonical": "module"
    },
    "option": {
      "source_kind": "MesonOption",
      "canonical": "variable_decl"
    }
  },
  "required_kinds": [
    "project",
    "target",
    "variable",
    "dependency",
    "subproject",
    "option"
  ],
  "oracle_kinds": {
    "tool": {
      "module": "module",
      "target": "target",
      "variable_decl": "variable_decl",
      "import": "import"
    }
  },
  "name_match": "identity",
  "names": {
    "trim_quotes": true
  },
  "qualify": {
    "chain_containers": false,
    "container_sep": ".",
    "method_sep": "."
  },
  "package": {
    "strategy": "dir"
  },
  "imports": {
    "strategy": "relative-path",
    "relative": true,
    "index_files": [
      "meson.build"
    ]
  },
  "signature": {
    "max_chars": 200
  },
  "target_level": "L3",
  "queue_id": "meson"
}
