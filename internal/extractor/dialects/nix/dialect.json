{
  "id": "nix",
  "display": "Nix",
  "kind": "tooling",
  "engine": "tags",
  "lang_tag": "nix",
  "match": {
    "extensions": [
      ".nix"
    ],
    "basenames": [],
    "globs": [],
    "shebangs": [],
    "sniff": null
  },
  "grammar": {
    "blob": "nix",
    "entry_point": "tree_sitter_nix"
  },
  "variants": [],
  "queries": {
    "tags": "tags.scm",
    "imports": "imports.scm"
  },
  "kinds": {
    "function": {
      "source_kind": "NixFunction",
      "canonical": "function",
      "callable": true
    },
    "option": {
      "source_kind": "NixOption",
      "canonical": "variable_decl",
      "callable": true
    },
    "package": {
      "source_kind": "NixPackage",
      "canonical": "target",
      "callable": true
    },
    "attribute": {
      "source_kind": "NixAttribute",
      "canonical": "key",
      "callable": true
    },
    "variable": {
      "source_kind": "NixVariable",
      "canonical": "variable",
      "callable": true
    },
    "param": {
      "source_kind": "NixParam",
      "canonical": "variable_decl"
    }
  },
  "required_kinds": [
    "function",
    "option",
    "package",
    "attribute",
    "variable",
    "param"
  ],
  "oracle_kinds": {
    "tool": {
      "function": "function",
      "option": "variable_decl",
      "package": "target",
      "attribute": "key",
      "variable": "variable",
      "param": "variable_decl"
    }
  },
  "name_match": "bare",
  "qualify": {
    "chain_containers": false,
    "container_sep": ".",
    "method_sep": "."
  },
  "package": {
    "strategy": "dir"
  },
  "imports": {
    "strategy": "relative-path",
    "relative": true,
    "suffixes": [],
    "index_files": [
      "default.nix",
      "flake.nix"
    ]
  },
  "signature": {
    "max_chars": 200
  },
  "calls": {
    "qualify": true
  },
  "target_level": "L3",
  "queue_id": "nix"
}
