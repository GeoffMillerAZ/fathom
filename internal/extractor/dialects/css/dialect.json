{
  "id": "css",
  "display": "CSS",
  "kind": "language",
  "engine": "tags",
  "lang_tag": "css",
  "match": {
    "extensions": [".css"],
    "basenames": [],
    "globs": [],
    "shebangs": [],
    "sniff": null
  },
  "grammar": { "blob": "css", "entry_point": "tree_sitter_css" },
  "variants": [
    {
      "id": "tailwind",
      "entry_point": "tree_sitter_css",
      "extensions": [],
      "sniff": "(?:^|[;{}\\s])@(?:theme|utility|custom-variant|variant|apply|source|plugin|config)\\b",
      "preprocess": "tailwind-at-rules",
      "call_names": "tailwind-candidate",
      "queries": { "tags": "tailwind.scm" }
    }
  ],
  "queries": { "tags": "tags.scm", "imports": "imports.scm" },
  "kinds": {
    "selector":         { "source_kind": "CSSSelector", "canonical": "selector" },
    "keyframes":         { "source_kind": "CSSKeyframes", "canonical": "rule", "container": true },
    "custom_property":  { "source_kind": "CSSCustomProperty", "canonical": "variable" },
    "module":           { "source_kind": "CSSModule", "canonical": "module" },
    "tw_theme":         { "source_kind": "TailwindTheme", "canonical": "variable" },
    "tw_utility":       { "source_kind": "TailwindUtility", "canonical": "mixin" },
    "tw_variant":       { "source_kind": "TailwindVariant", "canonical": "macro" }
  },
  "required_kinds": ["selector"],
  "oracle_kinds": {
    "ctags": { "class": "selector", "id": "selector", "selector": "selector" },
    "tool":  { "selector": "selector", "keyframes": "rule", "custom_property": "variable" }
  },
  "name_match": "identity",
  "module_symbol": "module",
  "ctags": { "languages": ["CSS"], "args": ["--sort=no"] },
  "qualify": { "chain_containers": false, "container_sep": ".", "method_sep": "." },
  "package": { "strategy": "dir" },
  "imports": { "strategy": "relative-path", "relative": true, "suffixes": [".css"] },
  "signature": { "max_chars": 200 },
  "target_level": "L3",
  "queue_id": "css"
}
