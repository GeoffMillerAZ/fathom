{
  "id": "crossplane",
  "display": "Crossplane compositions, definitions and packages",
  "kind": "tooling",
  "engine": "doc",
  "lang_tag": "crossplane",
  "match": {
    "extensions": [],
    "basenames": [],
    "globs": [],
    "shebangs": [],
    "sniff": null
  },
  "variants": [],
