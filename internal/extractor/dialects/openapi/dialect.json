{
  "id": "openapi",
  "display": "OpenAPI / Swagger documents",
  "kind": "tooling",
  "engine": "doc",
  "lang_tag": "openapi",
  "match": {
    "extensions": [],
    "basenames": [],
    "globs": [],
    "shebangs": [],
    "sniff": null
  },
  "variants": [],
  "kinds": {
    "document":        { "source_kind": "OpenAPIDocument",       "canonical": "package" },
    "operation":       { "source_kind": "OpenAPIOperation",      "canonical": "route" },
    "schema":          { "source_kind": "OpenAPISchema",         "canonical": "type_alias" },
    "parameter":       { "source_kind": "OpenAPIParameter",      "canonical": "variable_decl" },
    "response":        { "source_kind": "OpenAPIResponse",       "canonical": "message" },
    "request_body":    { "source_kind": "OpenAPIRequestBody",    "canonical": "message" },
    "header":          { "source_kind": "OpenAPIHeader",         "canonical": "key" },
    "security_scheme": { "source_kind": "OpenAPISecurityScheme", "canonical": "policy" }
  },
  "required_kinds": ["document", "operation", "schema", "parameter", "response", "request_body", "header", "security_scheme"],
  "oracle_kinds": {
    "tool": { "package": "package", "route": "route", "type_alias": "type_alias", "variable_decl": "variable_decl", "message": "message", "key": "key", "policy": "policy" }
  },
  "name_match": "identity",
  "package": { "strategy": "none" },
  "signature": { "max_chars": 200 },
  "target_level": "L3",
  "queue_id": "openapi"
}
