{
    "name": "acme/app",
    "type": "project",
    "description": "An application.",
    "require": {
        "php": "^8.3",
        "acme/core": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Lib\\": ["lib/", "vendor-lib/"]
        }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit --colors",
        "lint": [
            "@php vendor/bin/pint --test",
            "@test"
        ]
    }
}
