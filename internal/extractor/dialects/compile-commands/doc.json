{
  "decode": "compile-commands",
  "detect": { "basenames": ["compile_commands.json"] },
  "entities": [
    { "select": "$[*]", "where": { "is_map": true },
      "kind": "step", "source_kind": "CompileUnit", "name": ".file", "signature": ".output" }
  ],
  "references": [
    { "from": "step", "select": "$.includes[*]", "value": "$", "to_kind": "step", "edge": "include_dir" },
    { "from": "step", "select": "$.defines[*]", "value": "$", "to_kind": "step", "edge": "define" },
    { "from": "step", "select": "$.out", "value": "$", "to_kind": "step", "edge": "output" }
  ]
}
