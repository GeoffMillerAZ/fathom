{
  "id": "cloudformation",
  "display": "AWS CloudFormation / SAM templates",
  "kind": "tooling",
  "engine": "doc",
  "lang_tag": "cloudformation",
  "match": {
    "extensions": [],
    "basenames": [],
    "globs": [],
    "shebangs": [],
    "sniff": null
  },
  "variants": [],
  "kinds": {
    "template":  { "source_kind": "CFNTemplate",  "canonical": "package" },
    "parameter": { "source_kind": "CFNParameter", "canonical": "variable_decl" },
    "mapping":   { "source_kind": "CFNMapping",   "canonical": "table" },
    "condition": { "source_kind": "CFNCondition", "canonical": "rule" },
    "resource":  { "source_kind": "CFNResource",  "canonical": "resource" },
    "output":    { "source_kind": "CFNOutput",    "canonical": "output" },
    "telemetry_identity": { "source_kind": "TelemetryIdentity", "canonical": "key" }
  },
  "required_kinds": ["template", "parameter", "mapping", "condition", "resource", "output"],
  "oracle_kinds": {
    "tool": { "package": "package", "variable_decl": "variable_decl", "table": "table", "rule": "rule", "resource": "resource", "output": "output" }
  },
  "name_match": "identity",
  "package": { "strategy": "none" },
  "signature": { "max_chars": 200 },
  "target_level": "L3",
  "queue_id": "cloudformation"
}
