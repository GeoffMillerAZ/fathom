#version 450
layout(local_size_x = 8, local_size_y = 4) in;

layout(std430, set = 0, binding = 0) buffer Storage {
    vec4 entries[];
} storage;

uniform float threshold;

float clampValue(float value) {
    return clamp(value, threshold, 1.0);
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    storage.entries[index] = vec4(clampValue(float(index)));
}
