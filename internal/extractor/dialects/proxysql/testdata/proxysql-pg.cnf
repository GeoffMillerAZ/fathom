cluster_sync_interfaces=false

pgsql_variables=
{
	interfaces="0.0.0.0:6133"
	threads=2
}

pgsql_servers =
(
	{ address="pg1.example.test" , port=5432 , hostgroup=0 },
	{ address="pg2.example.test" , port=5432 , hostgroup=1 }
)

pgsql_users =
(
	{ username="app" , password="secret" , default_hostgroup=0 }
)

pgsql_query_rules =
(
	{ rule_id=1 , active=1 , match_digest="^SELECT" , destination_hostgroup=1 , apply=1 }
)
