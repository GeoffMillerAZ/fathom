datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

enum Role {
  USER
  ADMIN @map("admin")
}

/// A person.
model User {
  id      Int      @id @default(autoincrement())
  email   String   @unique
  role    Role     @default(USER)
  posts   Post[]
  profile Profile?

  @@index([email])
}

model Post {
  id       Int     @id
  title    String
  author   User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId Int
  tags     Tag[]
  geo      Unsupported("point")?

  @@unique([authorId, title])
}

model Profile {
  id     Int  @id
  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique
}

model Tag {
  id    Int    @id
  name  String
  posts Post[]
}

view UserInfo {
  id    Int
  email String
  role  Role
}
