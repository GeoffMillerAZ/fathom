{
  "id": "python",
  "display": "Python",
  "kind": "language",
  "engine": "tags",
  "lang_tag": "py",
  "match": {
    "extensions": [".py"],
    "basenames": [],
    "globs": [],
    "shebangs": ["python", "pypy"],
    "sniff": null
  },
  "grammar": { "blob": "python", "entry_point": "tree_sitter_python" },
  "variants": [],
  "queries": { "tags": "tags.scm", "imports": "imports.scm", "references": "references.scm" },
  "kinds": {
    "class":    { "source_kind": "PythonClass",     "canonical": "class",      "container": true },
    "function": { "source_kind": "PythonFunc",      "canonical": "function",   "callable": true },
    "variable": { "source_kind": "PythonVar",       "canonical": "variable" },
    "type":     { "source_kind": "PythonTypeAlias", "canonical": "type_alias" },
    "field":    { "source_kind": "PythonField",     "canonical": "field" },
    "module":   { "source_kind": "PythonModule",    "canonical": "module" }
  },
  "required_kinds": ["class", "function"],
  "oracle_kinds": {
    "ctags": { "class": "class", "function": "function", "member": "function", "variable": "variable" }
  },
  "qualify": { "chain_containers": false, "container_sep": ".", "method_sep": "." },
  "package": { "strategy": "dir" },
  "imports": { "strategy": "dotted-module" },
  "signature": { "max_chars": 200 },
  "calls": { "qualify": true },
  "module_symbol": "module",
  "target_level": "L4",
  "queue_id": "python"
}
