{
 "decode": "yaml",
 "detect": {
  "require_keys": [
   "policies"
  ],
  "content_sniff": "(?s)(?m:^policies[ \\t]*:).*(?m:^[ \\t]+(?:-[ \\t]+)?resource[ \\t]*:)"
 },
 "entities": [
  {
   "select": "$.policies[*]",
   "where": {
    "is_map": true,
    "has_key": [
     "name",
     "resource"
    ]
   },
   "kind": "policy",
   "source_kind": "CustodianPolicy",
   "name": ".name",
   "signature": ".resource"
  }
 ],
 "references": [
  {
   "from": "CustodianPolicy",
   "select": "$.filters[*]",
   "value": ".type | $",
   "to_kind": "policy",
   "edge": "filter"
  },
  {
   "from": "CustodianPolicy",
   "select": "$.filters..or[*]",
   "value": ".type | $",
   "to_kind": "policy",
   "edge": "filter"
  },
  {
   "from": "CustodianPolicy",
   "select": "$.filters..and[*]",
   "value": ".type | $",
   "to_kind": "policy",
   "edge": "filter"
  },
  {
   "from": "CustodianPolicy",
   "select": "$.filters..not[*]",
   "value": ".type | $",
   "to_kind": "policy",
   "edge": "filter"
  },
  {
   "from": "CustodianPolicy",
   "select": "$.actions[*]",
   "value": ".type | $",
   "to_kind": "policy",
   "edge": "action"
  }
 ],
 "cross_file": [
  {
   "from": "CustodianPolicy",
   "select": "$",
   "value": ".resource",
   "resolve": "resource-type",
   "edge": "policy_ref",
