{
  "id": "php",
  "display": "PHP",
  "kind": "language",
  "engine": "tags",
  "lang_tag": "php",
  "match": {
    "extensions": [".php"],
    "basenames": [],
    "globs": [],
    "shebangs": [],
    "sniff": null
  },
  "grammar": { "blob": "php", "entry_point": "tree_sitter_php" },
  "variants": [],
  "queries": { "tags": "tags.scm", "imports": "imports.scm", "references": "references.scm" },
  "kinds": {
    "namespace": { "source_kind": "PhpNamespace", "canonical": "namespace" },
    "class":     { "source_kind": "PhpClass",     "canonical": "class",     "container": true },
    "interface": { "source_kind": "PhpInterface", "canonical": "interface", "container": true },
    "trait":     { "source_kind": "PhpTrait",     "canonical": "trait",     "container": true },
    "enum":      { "source_kind": "PhpEnum",      "canonical": "enum",      "container": true },
    "function":  { "source_kind": "PhpFunction",  "canonical": "function",  "callable": true },
    "method":    { "source_kind": "PhpMethod",    "canonical": "method",    "callable": true },
    "property":  { "source_kind": "PhpProperty",  "canonical": "property",    "callable": true },
    "const":     { "source_kind": "PhpConst",     "canonical": "constant",    "callable": true },
    "enum_case": { "source_kind": "PhpEnumCase",  "canonical": "enum_member", "callable": true }
  },
  "required_kinds": ["namespace", "class", "interface", "trait", "function", "method"],
  "oracle_kinds": {
    "ctags": { "namespace": "namespace", "class": "class", "interface": "interface", "trait": "trait",
               "function": "function", "function@scoped": "method" },
    "tool":  { "namespace": "namespace", "class": "class", "interface": "interface", "trait": "trait",
               "enum": "enum", "function": "function", "method": "method" }
  },
  "qualify": { "chain_containers": true, "container_sep": ".", "method_sep": "." },
  "package": { "strategy": "capture" },
  "imports": { "strategy": "namespace-dir", "separator": "\\", "suffixes": [".php"] },
  "signature": { "max_chars": 200 },
  "calls": { "qualify": true },
  "target_level": "L4",
  "queue_id": "php"
}
