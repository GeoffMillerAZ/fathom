{
  "id": "ruby",
  "display": "Ruby",
  "kind": "language",
  "engine": "tags",
  "lang_tag": "ruby",
  "match": {
    "extensions": [".rb"],
    "basenames": [],
    "globs": [],
    "shebangs": [],
    "sniff": null
  },
  "grammar": { "blob": "ruby", "entry_point": "tree_sitter_ruby" },
  "variants": [],
  "queries": { "tags": "tags.scm" },
  "kinds": {
    "module": { "source_kind": "RubyModule", "canonical": "module", "container": true },
    "class":  { "source_kind": "RubyClass",  "canonical": "class",  "container": true },
    "method": { "source_kind": "RubyMethod", "canonical": "method", "callable": true }
  },
  "required_kinds": ["class", "module", "method"],
  "oracle_kinds": {
    "ctags": { "class": "class", "module": "module", "method": "method", "singletonMethod": "method",
               "accessor": "property", "constant": "constant", "alias": "method" }
  },
  "qualify": { "chain_containers": true, "container_sep": "::", "method_sep": "." },
  "package": { "strategy": "dir" },
  "signature": { "max_chars": 200 },
  "target_level": "L3",
  "queue_id": "ruby"
}
