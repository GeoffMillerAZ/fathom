{
  "id": "cuda",
  "display": "CUDA (.cu .cuh)",
  "kind": "language",
  "engine": "tags",
  "lang_tag": "cuda",
  "match": {
    "extensions": [".cu", ".cuh"],
    "basenames": [],
    "globs": [],
    "shebangs": [],
    "sniff": null
  },
  "grammar": { "blob": "cuda", "entry_point": "tree_sitter_cuda" },
  "variants": [],
  "queries": { "tags": "tags.scm", "imports": "imports.scm", "references": "references.scm" },
  "kinds": {
    "namespace": { "source_kind": "CudaNamespace", "canonical": "namespace", "container": true },
    "class":     { "source_kind": "CudaClass",     "canonical": "class",     "container": true },
    "struct":    { "source_kind": "CudaStruct",    "canonical": "struct",    "container": true },
    "union":     { "source_kind": "CudaUnion",     "canonical": "union",     "container": true },
    "enum":      { "source_kind": "CudaEnum",      "canonical": "enum",      "container": true },
    "function":  { "source_kind": "CudaFunc",      "canonical": "function",  "callable": true },
    "typedef":   { "source_kind": "CudaTypedef",   "canonical": "type_alias", "container": true },
    "macro":     { "source_kind": "CudaMacro",     "canonical": "macro" },
    "field":      { "source_kind": "CudaField",      "canonical": "field" },
    "enumerator": { "source_kind": "CudaEnumerator", "canonical": "enum_member" },
    "variable":   { "source_kind": "CudaVariable",   "canonical": "variable" },
    "module":     { "source_kind": "CudaModule",     "canonical": "module" }
  },
  "required_kinds": ["namespace", "class", "struct", "union", "enum", "function", "typedef", "macro"],
  "oracle_kinds": {
    "ctags": { "namespace": "namespace", "class": "class", "struct": "struct", "union": "union",
               "enum": "enum", "function": "function", "typedef": "type_alias", "macro": "macro" }
  },
  "ctags": { "languages": ["C++"], "args": ["--map-C++=+.cu", "--map-C++=+.cuh", "-I__global__,__device__,__host__,__forceinline__,__noinline__,__shared__,__constant__,__managed__,__restrict__,__launch_bounds__+"] },
  "qualify": { "chain_containers": true, "container_sep": ".", "method_sep": ".", "scope_sep": "::" },
  "calls": { "qualify": true },
  "package": { "strategy": "dir" },
  "imports": { "strategy": "include-path" },
  "preprocess": "cuda-macros",
  "module_symbol": "module",
  "signature": { "max_chars": 200 },
  "target_level": "L4",
  "queue_id": "cuda"
}
