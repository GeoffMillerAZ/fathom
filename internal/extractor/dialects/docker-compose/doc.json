{
  "decode": "yaml",
  "detect": {
    "basenames": ["docker-compose.yml", "docker-compose.yaml", "compose.yml", "compose.yaml"],
    "globs": [
      "**/docker-compose.*.yml", "**/docker-compose.*.yaml",
      "**/docker-compose-*.yml", "**/docker-compose-*.yaml",
      "**/compose.*.yml", "**/compose.*.yaml",
      "**/compose-*.yml", "**/compose-*.yaml"
    ]
  },
  "entities": [
    { "select": "$", "where": { "is_map": true },
      "kind": "package", "source_kind": "ComposeFile", "name": "$file", "signature": ".name" },

    { "select": "$.services.*", "where": { "is_map": true },
      "kind": "service", "source_kind": "ComposeService", "name": "$key",
      "signature": ".image | .build.context | .build" },

    { "select": "$.services.*.environment.OTEL_SERVICE_NAME", "where": { "is_scalar": true },
      "kind": "key", "source_kind": "TelemetryIdentity", "name": "$",
      "signature": "fmt:service.name={$}" },
    { "select": "$.services.*.environment.NEW_RELIC_APP_NAME", "where": { "is_scalar": true },
      "kind": "key", "source_kind": "TelemetryIdentity", "name": "$ cut:;",
      "signature": "fmt:newrelic.app_name={$ cut:;}" }
  ],
  "references": [
    { "from": "service", "select": "$.depends_on[*]", "value": "$", "to_kind": "service", "edge": "depends_on" },
    { "from": "service", "select": "$.depends_on.*", "value": "$key", "to_kind": "service", "edge": "depends_on" }
  ],
  "cross_file": [
    { "from": "service", "select": "$.extends.file", "value": "$", "resolve": "repo-path", "edge": "extends" },
    { "select": "$.include[*]", "value": "$", "resolve": "repo-path", "edge": "includes" },
    { "select": "$.include[*].path[*]", "value": "$", "resolve": "repo-path", "edge": "includes" },
    { "from": "service", "select": "$.image", "value": "$", "resolve": "image-ref", "edge": "runs" },
    { "from": "service", "select": "$.build", "value": "$ | .context", "resolve": "repo-path", "edge": "build" },
    { "from": "service", "select": "$.build.dockerfile", "value": "$", "resolve": "repo-path", "edge": "build_dockerfile" }
  ]
}
