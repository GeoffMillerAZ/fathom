{
  "id": "checkov-policies",
  "display": "Checkov custom policies (Python checks, YAML graph checks)",
  "kind": "tooling",
  "engine": "tags+doc",
  "lang_tag": "checkov-policies",
  "match": {
    "extensions": [],
    "basenames": [],
    "globs": [
      "**/checks/resource/**/*.py",
      "**/checks/data/**/*.py",
      "**/checks/provider/**/*.py",
      "**/checks/module/**/*.py",
      "**/checks/graph_checks/**/*.yaml",
      "**/checks/graph_checks/**/*.yml"
    ],
    "shebangs": [],
    "sniff": null
  },
  "grammar": { "blob": "python", "entry_point": "tree_sitter_python" },
  "variants": [],
  "queries": { "tags": "tags.scm" },
  "kinds": {
    "check":       { "source_kind": "CheckovCheck",      "canonical": "policy", "callable": true },
    "graph_check": { "source_kind": "CheckovGraphCheck", "canonical": "policy" }
  },
  "required_kinds": ["check", "graph_check"],
  "oracle_kinds": {
    "tool": { "check": "policy" }
  },
  "name_match": "identity",
  "qualify": { "chain_containers": false, "container_sep": ".", "method_sep": "." },
  "package": { "strategy": "dir" },
  "signature": { "max_chars": 200 },
  "target_level": "L2",
  "queue_id": "checkov-policies"
}
