  "entities": [
    {"select": "$", "where": {"has_key": ["kind", "metadata"]}, "kind": "resource", "source_kind": "FluxResource", "name": ".metadata.name", "qualify": [".kind", ".metadata.namespace"], "signature": ".kind"}
  ],
  "references": [
    {"from": "resource", "select": "$.spec.sourceRef.name", "value": "$", "to_kind": "resource", "edge": "source_ref"},
    {"from": "resource", "select": "$.spec.chart.spec.sourceRef.name", "value": "$", "to_kind": "resource", "edge": "chart_source"},
    {"from": "resource", "select": "$.spec.chartRef.name", "value": "$", "to_kind": "resource", "edge": "chart_ref"},
    {"from": "resource", "select": "$.spec.dependsOn[*].name", "value": "$", "to_kind": "resource", "edge": "depends_on"},
    {"from": "resource", "select": "$.spec.valuesFrom[*].name", "value": "$", "to_kind": "resource", "edge": "values_from"}
  ],
  "cross_file": [
    {"from": "resource", "select": "$", "value": "fmt:{.spec.sourceRef.kind}/{.spec.sourceRef.namespace | .metadata.namespace}/{.spec.sourceRef.name}", "resolve": "service-name", "edge": "source_ref"},
    {"from": "resource", "select": "$", "value": "fmt:{.spec.sourceRef.kind}/{.spec.sourceRef.name}", "resolve": "service-name", "edge": "source_ref"},
    {"from": "resource", "select": "$", "value": "fmt:{.spec.chart.spec.sourceRef.kind}/{.spec.chart.spec.sourceRef.namespace | .metadata.namespace}/{.spec.chart.spec.sourceRef.name}", "resolve": "service-name", "edge": "chart_source"},
    {"from": "resource", "select": "$", "value": "fmt:{.spec.chart.spec.sourceRef.kind}/{.spec.chart.spec.sourceRef.name}", "resolve": "service-name", "edge": "chart_source"},
    {"from": "resource", "select": "$", "value": "fmt:{.spec.chartRef.kind}/{.spec.chartRef.namespace | .metadata.namespace}/{.spec.chartRef.name}", "resolve": "service-name", "edge": "chart_ref"},
    {"from": "resource", "select": "$", "value": "fmt:{.spec.chartRef.kind}/{.spec.chartRef.name}", "resolve": "service-name", "edge": "chart_ref"},
    {"from": "resource", "where": {"equals": {".kind": "Kustomization"}}, "select": "$", "value": "fmt:Kustomization/{.spec.dependsOn[0].namespace | .metadata.namespace}/{.spec.dependsOn[0].name}", "resolve": "service-name", "edge": "depends_on"},
