{
  "id": "rust",
  "display": "Rust",
  "kind": "language",
  "engine": "tags",
  "lang_tag": "rust",
  "match": {
    "extensions": [".rs"],
    "basenames": [],
    "globs": [],
    "shebangs": [],
    "sniff": null
  },
  "grammar": { "blob": "rust", "entry_point": "tree_sitter_rust" },
  "variants": [],
  "queries": { "tags": "tags.scm", "imports": "imports.scm", "references": "references.scm" },
  "kinds": {
    "function":   { "source_kind": "RustFn",        "canonical": "function",   "callable": true },
    "struct":     { "source_kind": "RustStruct",    "canonical": "struct",     "container": true },
    "enum":       { "source_kind": "RustEnum",      "canonical": "enum",       "container": true },
    "union":      { "source_kind": "RustUnion",     "canonical": "union",      "container": true },
    "variant":    { "source_kind": "RustVariant",   "canonical": "enum_member", "callable": true },
    "field":      { "source_kind": "RustField",     "canonical": "field",      "callable": true },
    "assoc_const": { "source_kind": "RustAssocConst", "canonical": "field",    "callable": true },
    "assoc_type": { "source_kind": "RustAssocType", "canonical": "field",      "callable": true },
    "trait":      { "source_kind": "RustTrait",     "canonical": "trait",      "container": true },
    "impl":       { "source_kind": "RustImpl",      "canonical": "class",      "container": true },
    "mod":        { "source_kind": "RustMod",       "canonical": "module" },
    "type_alias": { "source_kind": "RustTypeAlias", "canonical": "type_alias" },
    "const":      { "source_kind": "RustConst",     "canonical": "constant" },
    "static":     { "source_kind": "RustStatic",    "canonical": "variable" },
    "macro":      { "source_kind": "RustMacro",     "canonical": "macro" }
  },
  "required_kinds": ["function", "struct", "enum", "trait"],
  "oracle_kinds": {
    "ctags": { "function": "function", "method": "function", "struct": "struct", "enum": "enum",
               "interface": "trait", "implementation": "class", "module": "module",
               "typedef": "type_alias", "typedef@scoped": "field",
               "constant": "constant", "constant@scoped": "field",
               "variable": "variable", "variable@scoped": "field",
               "macro": "macro", "field": "field", "enumerator": "enum_member" },
    "scip": { "struct": "struct", "enum": "enum", "trait": "trait",
              "function": "function", "method": "function", "staticmethod": "function", "traitmethod": "function",
              "macro": "macro", "module": "module",
              "constant": "constant", "const": "constant", "constant@scoped": "field", "const@scoped": "field",
              "staticvariable": "variable",
              "typealias": "type_alias", "type": "type_alias", "type@scoped": "field", "associatedtype": "field",
              "field": "field", "enummember": "enum_member" }
  },
  "qualify": { "chain_containers": false, "container_sep": ".", "method_sep": ".", "scope_sep": "::" },
  "package": { "strategy": "dir" },
  "imports": { "strategy": "crate-mod" },
  "signature": { "max_chars": 200 },
  "target_level": "L4",
  "queue_id": "rust"
}
