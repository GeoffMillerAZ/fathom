{
  "id": "cpp",
  "display": "C++",
  "kind": "language",
  "engine": "tags",
  "lang_tag": "cpp",
  "match": {
    "extensions": [".cc", ".cpp", ".cxx", ".hpp", ".hh", ".hxx"],
    "basenames": [],
    "globs": [],
    "shebangs": [],
    "sniff": null
  },
  "grammar": { "blob": "cpp", "entry_point": "tree_sitter_cpp" },
  "variants": [],
  "queries": { "tags": "tags.scm", "imports": "imports.scm", "references": "references.scm" },
  "kinds": {
    "namespace": { "source_kind": "CppNamespace", "canonical": "namespace", "container": true },
    "class":     { "source_kind": "CppClass",     "canonical": "class",     "container": true },
    "struct":    { "source_kind": "CppStruct",    "canonical": "struct",    "container": true },
    "union":     { "source_kind": "CppUnion",     "canonical": "union",     "container": true },
    "enum":      { "source_kind": "CppEnum",      "canonical": "enum",      "container": true },
    "function":  { "source_kind": "CppFunc",      "canonical": "function",  "callable": true },
    "typedef":   { "source_kind": "CppTypedef",   "canonical": "type_alias", "container": true },
    "macro":     { "source_kind": "CppMacro",     "canonical": "macro" },
    "field":      { "source_kind": "CppField",      "canonical": "field" },
    "enumerator": { "source_kind": "CppEnumerator", "canonical": "enum_member" },
    "variable":   { "source_kind": "CppVariable",   "canonical": "variable" },
    "module":     { "source_kind": "CppModule",     "canonical": "module" }
  },
  "required_kinds": ["namespace", "class", "struct", "union", "enum", "function", "typedef", "macro"],
  "oracle_kinds": {
    "ctags": { "namespace": "namespace", "class": "class", "struct": "struct", "union": "union",
               "enum": "enum", "function": "function", "typedef": "type_alias", "macro": "macro" }
  },
  "qualify": { "chain_containers": true, "container_sep": ".", "method_sep": ".", "scope_sep": "::" },
  "calls": { "qualify": true },
  "package": { "strategy": "dir" },
  "imports": { "strategy": "include-path" },
  "preprocess": "cpp-macros",
  "module_symbol": "module",
  "signature": { "max_chars": 200 },
  "target_level": "L4",
  "queue_id": "cpp"
}
