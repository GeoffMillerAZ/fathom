<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.acme.shop</groupId>
  <artifactId>shop-parent</artifactId>
  <version>2.4.0</version>
  <packaging>pom</packaging>

  <modules>
    <module>shop-core</module>
    <module>shop-orders/</module>
    <module>services/billing</module>
    <module>tools/pom-tools.xml</module>
    <module>../sibling</module>
    <module>${extra.module}</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.acme.shop</groupId>
        <artifactId>shop-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.acme.bom</groupId>
        <artifactId>acme-bom</artifactId>
        <version>7</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <profiles>
    <profile>
      <id>extras</id>
      <modules>
        <module>extras</module>
      </modules>
    </profile>
  </profiles>
</project>
