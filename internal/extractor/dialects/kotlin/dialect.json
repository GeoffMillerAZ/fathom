{
  "id": "kotlin",
  "display": "Kotlin",
  "kind": "language",
  "engine": "tags",
  "lang_tag": "kotlin",
  "match": {
    "extensions": [".kt", ".kts"],
    "basenames": [],
    "globs": [],
    "shebangs": [],
    "sniff": null
  },
  "grammar": { "blob": "kotlin", "entry_point": "tree_sitter_kotlin" },
  "variants": [],
  "queries": { "tags": "tags.scm", "imports": "imports.scm", "references": "references.scm" },
  "kinds": {
    "class":      { "source_kind": "KotlinClass",      "canonical": "class",       "container": true },
    "interface":  { "source_kind": "KotlinInterface",  "canonical": "interface",   "container": true },
    "object":     { "source_kind": "KotlinObject",     "canonical": "class",       "container": true },
    "enum_entry": { "source_kind": "KotlinEnumEntry",  "canonical": "enum_member", "container": true },
    "function":   { "source_kind": "KotlinFunction",   "canonical": "function",    "callable": true },
    "constructor": { "source_kind": "KotlinConstructor", "canonical": "constructor", "callable": true },
    "property":   { "source_kind": "KotlinProperty",   "canonical": "property" },
    "typealias":  { "source_kind": "KotlinTypeAlias",  "canonical": "type_alias" },
    "import":     { "source_kind": "KotlinImport",     "canonical": "import" }
  },
  "required_kinds": ["class", "interface", "object", "enum_entry", "function", "constructor", "property", "typealias"],
  "oracle_kinds": {
    "ctags": { "class": "class", "interface": "interface", "object": "class", "method": "function",
               "variable": "property", "constant": "property", "typealias": "type_alias",
               "package": "package" },
    "tool":  { "class": "class", "interface": "interface", "object": "class", "enumEntry": "enum_member",
               "function": "function", "constructor": "constructor", "property": "property",
               "typealias": "type_alias" }
  },
  "names": { "trim_quotes": true },
  "qualify": { "chain_containers": true, "container_sep": ".", "method_sep": "." },
  "package": { "strategy": "capture" },
  "imports": { "strategy": "namespace-dir", "suffixes": [".kt"] },
  "signature": { "max_chars": 200 },
  "target_level": "L4",
  "queue_id": "kotlin"
}
