+================================================================================
+Conditional function declarators
+================================================================================
+
+int
+#ifdef USE_FAST_NAME
+select_name(fast_path, item_type)
+#else
+select_name(safe_path, item_type)
+#endif
+(int value) {
+  return value;
+}
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (function_definition
+    (primitive_type)
+    (function_declarator
+      (preproc_ifdef
+        (identifier)
+        (macro_declarator
+          (identifier)
+          (argument_list
+            (identifier)
+            (identifier)))
+        (preproc_else
+          (macro_declarator
+            (identifier)
+            (argument_list
+              (identifier)
+              (identifier)))))
+      (parameter_list
+        (parameter_declaration
+          (primitive_type)
+          (identifier))))
+    (compound_statement
+      (return_statement
+        (identifier)))))
+
+================================================================================
+Conditional function declarators preserve elif branches
+================================================================================
+
+int
+#if USE_FAST_NAME
+select_name(fast_path, item_type)
+#elif USE_SAFE_NAME
+select_name(safe_path, item_type)
+#else
+select_name(fallback_path, item_type)
+#endif
+(int value) {
+  return value;
+}
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (function_definition
+    (primitive_type)
+    (function_declarator
+      (preproc_if
+        (identifier)
+        (macro_declarator
+          (identifier)
+          (argument_list
+            (identifier)
+            (identifier)))
+        (preproc_elif
+          (identifier)
+          (macro_declarator
+            (identifier)
+            (argument_list
+              (identifier)
+              (identifier)))
+          (preproc_else
+            (macro_declarator
+              (identifier)
+              (argument_list
+                (identifier)
+                (identifier))))))
+      (parameter_list
+        (parameter_declaration
+          (primitive_type)
+          (identifier))))
+    (compound_statement
+      (return_statement
+        (identifier)))))
+
+================================================================================
+Conditional function declaration declarators
+================================================================================
+
+int
+#ifdef USE_FAST_NAME
+select_name(fast_path, item_type)
+#else
+select_name(safe_path, item_type)
+#endif
+(int value);
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (declaration
+    (primitive_type)
+    (function_declarator
+      (preproc_ifdef
+        (identifier)
+        (macro_declarator
+          (identifier)
+          (argument_list
+            (identifier)
+            (identifier)))
+        (preproc_else
+          (macro_declarator
+            (identifier)
+            (argument_list
+              (identifier)
+              (identifier)))))
+      (parameter_list
+        (parameter_declaration
+          (primitive_type)
+          (identifier))))))
+
+================================================================================
+Conditional function-call arguments
+================================================================================
+
+void invoke(void) {
+  combine(first,
+#ifdef EXTRA_VALUE
+    second,
+#endif
+    third);
+}
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (function_definition
+    (primitive_type)
+    (function_declarator
+      (identifier)
+      (parameter_list
+        (parameter_declaration
+          (primitive_type))))
+    (compound_statement
+      (expression_statement
+        (call_expression
+          (identifier)
+          (argument_list
+            (identifier)
+            (preproc_ifdef
+              (identifier)
+              (identifier))
+            (identifier)))))))
+
+================================================================================
+Conditional function-call arguments preserve both branches
+================================================================================
+
+void select(void) {
+  merge(first,
+#if USE_SECOND
+    second,
+#else
+    alternate,
+#endif
+    final);
+}
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (function_definition
+    (primitive_type)
+    (function_declarator
+      (identifier)
+      (parameter_list
+        (parameter_declaration
+          (primitive_type))))
+    (compound_statement
+      (expression_statement
+        (call_expression
+          (identifier)
+          (argument_list
+            (identifier)
+            (preproc_if
+              (identifier)
+              (identifier)
+              (preproc_else
+                (identifier)))
+            (identifier)))))))
+
+================================================================================
+Conditional function-call arguments require valid separators in every branch
+================================================================================
+
+void validate(void) {
+  merge(first,
+#if USE_SECOND
+    second,
+#else
+    alternate
+#endif
+    final);
+}
+
