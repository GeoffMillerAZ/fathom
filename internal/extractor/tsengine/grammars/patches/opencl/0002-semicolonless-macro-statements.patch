@@ -0,0 +1,200 @@
+================================================================================
+Semicolonless macro item before declarations and a function head
+================================================================================
+
+EMIT_TILE(1, 0)
+int result;
+int compute(int value) { return value; }
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (macro_invocation_statement
+    (identifier)
+    (argument_list
+      (number_literal)
+      (number_literal)))
+  (declaration
+    (primitive_type)
+    (identifier))
+  (function_definition
+    (primitive_type)
+    (function_declarator
+      (identifier)
+      (parameter_list
+        (parameter_declaration
+          (primitive_type)
+          (identifier))))
+    (compound_statement
+      (return_statement
+        (identifier)))))
+
+================================================================================
+Semicolonless macro statement in a function
+================================================================================
+
+void process_value(void) {
+  ADVANCE_TILE(4)
+  int offset = 1;
+  return;
+}
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (function_definition
+    (primitive_type)
+    (function_declarator
+      (identifier)
+      (parameter_list
+        (parameter_declaration
+          (primitive_type))))
+    (compound_statement
+      (macro_invocation_statement
+        (identifier)
+        (argument_list
+          (number_literal)))
+      (declaration
+        (primitive_type)
+        (init_declarator
+          (identifier)
+          (number_literal)))
+      (return_statement))))
+
+================================================================================
+Multiline semicolonless macro with a physical line break after close
+================================================================================
+
+BUILD_TILE(
+  1,
+  value
+)
+int result;
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (macro_invocation_statement
+    (identifier)
+    (argument_list
+      (number_literal)
+      (identifier)))
+  (declaration
+    (primitive_type)
+    (identifier)))
+
+================================================================================
+Macro typed declaration on one line stays a declaration
+================================================================================
+
+FOO(a) x;
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (declaration
+    (macro_type_specifier
+      (identifier)
+      (type_descriptor
+        (type_identifier)))
+    (identifier)))
+
+================================================================================
+Macro typed declaration across lines stays a declaration
+================================================================================
+
+FOO(a)
+x;
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (declaration
+    (macro_type_specifier
+      (identifier)
+      (type_descriptor
+        (type_identifier)))
+    (identifier)))
+
+================================================================================
+Ordinary missing semicolon is still an error
+================================================================================
+
+void process_value(void) {
+  value = helper(value)
+  return;
+}
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (function_definition
+    (primitive_type)
+    (function_declarator
+      (identifier)
+      (parameter_list
+        (parameter_declaration
+          (primitive_type))))
+    (compound_statement
+      (expression_statement
+        (assignment_expression
+          (identifier)
+          (call_expression
+            (identifier)
+            (argument_list
+              (identifier))))
+        (ERROR
+          (identifier))))))
+
+================================================================================
+Same line following block reports a missing newline boundary
+================================================================================
+
+void process_value(void) {
+  EMIT_TILE(2) { return; }
+}
+
+--------------------------------------------------------------------------------
+
+(translation_unit
+  (function_definition
+    (primitive_type)
+    (function_declarator
+      (identifier)
+      (parameter_list
+        (parameter_declaration
