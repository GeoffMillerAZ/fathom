// testdata/outputschema.cue — fixture for the structured-outputs end-to-end
// test.  Defines a simple scored-analysis result type that exercises: named
// definition, required string fields, integer with a lower bound, optional
// string field, and string-enum — the constructs most commonly used when
// constraining LLM generation.
//
// The derived JSON Schema (outputschema_golden.json) is generated by:
//
//	go test ./toolchains/jsonschema/... -run TestOutputSchemaEndToEnd -update
//
// or via: jsonschemagen.DeriveFromDir("testdata", Options{}) written to the
// golden file.
package outputschema

// #ScoredAnalysis is the output contract for a scored analysis response.
// When used as Request.OutputSchema it constrains the model to emit a JSON
// object conforming to this shape.
#ScoredAnalysis: {
	// Summary is a concise summary of the analysis result.
	summary: string

	// Score is the numeric confidence score (0–100 inclusive).
	score: >=0 & <=100 & int

	// Verdict is one of the allowed classification labels.
	verdict: "positive" | "negative" | "neutral"

	// Notes is an optional free-form annotation.
	notes?: string
}
