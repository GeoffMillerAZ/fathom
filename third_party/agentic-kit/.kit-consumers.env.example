# Copy to .kit-consumers.env (gitignored). Each variable names the checkout of a
# real downstream consumer; unset or empty means the matching check skips.
# Relative paths resolve from the kit root.
KIT_CONSUMER_A_DIR=/path/to/consumer-a
KIT_CONSUMER_B_DIR=/path/to/consumer-b
KIT_CONSUMER_C_DIR=/path/to/consumer-c
# Platform consumer for the catalog-kit pilots (kits/catalog-kit/pilots/run.sh).
KIT_PLATFORM_DIR=/path/to/platform-repo
KIT_PLATFORM_REVIEW_PATH=kits/review-pack
KIT_PLATFORM_ENV_PATH=kits/env-pack
KIT_PLATFORM_REVIEW_MODULE=example.invalid/platform-repo/kits/review-pack
