// Package queryplanner defines CUE contracts for the query-planner foundation.
// Go types in types.go and queryplanner.go are the Go counterpart; drift is a bug.
package queryplanner

// #PlannedQuery is a single search query targeting one provider.
#PlannedQuery: {
	// Provider identifies the search provider (e.g. "gmail", "drive", "slack").
	Provider: string & !=""
	// Account is the specific provider account to search (may be empty when
	// the caller supplies a single-account default).
	Account: string
	// Query is the provider-native query string.
	Query: string & !=""
	// Rationale explains why this query is expected to be useful.
	Rationale: string
	// IsAI is true when the query was generated by an LLM; false for
	// deterministic queries authored by the planner logic.
	IsAI: bool
	// Warnings is a list of DLP-related cautions about the query string (e.g.
	// "query may contain SSN-like pattern"). Empty when no warnings apply.
	Warnings: [...string]
}

// #Brief is the human-authored description of what the investigator seeks.
#Brief: {
	ID:   string & !=""
	Text: string & !=""
}

// #DateRange is an optional filter bounding the search period.
// Both fields use RFC3339 date strings ("2026-01-15"); zero means unbounded.
#DateRange: {
	Start: string
	End:   string
}
