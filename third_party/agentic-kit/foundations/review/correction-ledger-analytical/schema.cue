// Package correctionledgeranalytical defines CUE contracts for
// Parquet-export-eligible analytical projections of the correction ledger.
// These constraints mirror the Go types and are evaluated with `cue vet ./...`.
package correctionledgeranalytical

// #AnalyticalEventKind enumerates the two kinds of events the analytical
// projection surfaces: corrections (underlying fact was wrong) and
// dismissals (finding was a false positive).
#AnalyticalEventKind: "correction" | "dismissal"

// #AnalyticalEvent is an immutable, timestamped, versioned record produced
// from correction or dismissal activity in the correction ledger. It is the
// unit emitted to the analytical substrate for time-travel queries.
//
// All fields are required and non-empty to guarantee every Parquet row is
// fully populated.
#AnalyticalEvent: {
	// ID is a stable, unique identifier for this analytical event.
	// Format: "<kind>:<FindingID>:<Version>" (generated by Project).
	ID: string & !=""

	// Kind discriminates correction vs dismissal activity.
	Kind: #AnalyticalEventKind

	// Target is the stable identifier for the entity whose activity is
	// recorded.  For corrections this is the CorrectionTarget.StableTarget;
	// for dismissals it is the FindingID (the finding itself is the target).
	Target: string & !=""

	// At is the RFC 3339 UTC timestamp when the activity occurred
	// (CorrectedAt or DismissedAt).
	At: string & !=""

	// Version is a monotonically increasing sequence number among all
	// AnalyticalEvents for the same Target, assigned by Project.
	// Starts at 1.
	Version: >=1 & int
}
