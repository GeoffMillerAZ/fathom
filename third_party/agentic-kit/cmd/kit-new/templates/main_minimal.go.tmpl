// Exit codes: 0 = run completed; 1 = startup or run failure; 2 = usage error.
package main

import (
	"context"
	"encoding/json"
	"errors"
	"flag"
	"fmt"
	"io"
	"os"
	"time"

	toolregistry "github.com/geoffmilleraz/agentic-kit/foundations/agent/tool-registry"
	"github.com/geoffmilleraz/agentic-kit/foundations/llmclient"
	"github.com/geoffmilleraz/agentic-kit/foundations/llmclient/anthropic"
	agentharness "github.com/geoffmilleraz/agentic-kit/kits/agent-harness"
)

const (
	// apiKeyEnv names the environment variable holding the Anthropic API key.
	apiKeyEnv = "{{.APIKeyEnv}}"

	// defaultModel is the Anthropic model used when -model is not given.
	defaultModel = "claude-opus-4-8"

	// systemPrompt is the system-level instruction for every model call.
	systemPrompt = "You are a helpful assistant. Answer the user's question concisely using the available tools."
)

// mockScript returns the scripted responses for -mode mock.
func mockScript() []llmclient.MockEntry {
	return []llmclient.MockEntry{
		llmclient.MockEntryWithResponse(llmclient.Response{
			Text:       "Hello! I'm your minimal agent. I'm ready to help.",
			StopReason: llmclient.StopEndTurn,
			Usage:      llmclient.Usage{InputTokens: 100, OutputTokens: 20},
		}),
	}
}

// newRegistry builds the tool registry.
func newRegistry() *toolregistry.Registry {
	reg := toolregistry.New(toolregistry.Options{
		DefaultTimeout: 10 * time.Second,
	})

	reg.MustRegister(toolregistry.Tool{
		Def: llmclient.ToolDef{
			Name:        "echo",
			Description: "Return the input text unchanged.",
			InputSchema: toolregistry.ObjectSchema(
				toolregistry.Prop{Name: "text", Type: "string", Description: "Text to echo back.", Required: true},
			),
		},
		Handler: func(_ context.Context, input json.RawMessage) (string, error) {
			var in struct {
				Text *string `json:"text"`
			}
			if err := json.Unmarshal(input, &in); err != nil {
				return "", fmt.Errorf("invalid input: %w", err)
			}
			if in.Text == nil {
				return "", errors.New(`input field "text" is required`)
			}
			return *in.Text, nil
		},
	})

	return reg
}

// run is the testable entry point.
func run(args []string, stdout, stderr io.Writer, getenv func(string) string) int {
	fs := flag.NewFlagSet("{{.Name}}", flag.ContinueOnError)
	fs.SetOutput(stderr)
	var (
		mode     = fs.String("mode", "mock", "client mode: mock or live")
		prompt   = fs.String("prompt", "Hello! What can you do?", "the user task")
		model    = fs.String("model", defaultModel, "model name")
		maxTurns = fs.Int("max-turns", 8, "maximum model calls per run")
		jsonOut  = fs.Bool("json", false, "emit the RunResult as JSON on stdout")
	)
	if err := fs.Parse(args); err != nil {
		return 2
	}

	switch *mode {
	case "mock", "live":
	default:
		fmt.Fprintf(stderr, "{{.Name}}: invalid -mode %q (want mock or live)\n", *mode)
		return 2
	}

	// ---- base client --------------------------------------------------------
	var client llmclient.LLMClient
	if *mode == "mock" {
		client = llmclient.NewMockClient(mockScript()...)
	} else {
		key := getenv(apiKeyEnv)
		if key == "" {
			fmt.Fprintf(stderr, "{{.Name}}: live mode needs an Anthropic API key: set %s and re-run\n", apiKeyEnv)
			return 1
		}
		c, err := anthropic.New(anthropic.Config{APIKey: key, DefaultModel: *model})
		if err != nil {
			fmt.Fprintf(stderr, "{{.Name}}: build client: %v\n", err)
			return 1
		}
		client = c
	}

	// ---- harness -------------------------------------------------------------
	h, err := agentharness.New(
		agentharness.Config{
			MaxTurns:         *maxTurns,
			System:           systemPrompt,
			Model:            *model,
			MaxTokensPerCall: 1024,
		},
		agentharness.Deps{
			Client:   client,
			Registry: newRegistry(),
			Now:      time.Now,
		},
	)
	if err != nil {
		fmt.Fprintf(stderr, "{{.Name}}: build harness: %v\n", err)
		return 1
	}

	result, runErr := h.Run(context.Background(), *prompt)

	if *jsonOut {
		enc := json.NewEncoder(stdout)
		enc.SetIndent("", "  ")
		if err := enc.Encode(result); err != nil {
			fmt.Fprintf(stderr, "{{.Name}}: encode result: %v\n", err)
			return 1
		}
	} else {
		fmt.Fprintf(stdout, "stop=%s turns=%d tool_calls=%d input_tokens=%d output_tokens=%d\n\n%s\n",
			result.Stop, result.Turns, result.ToolCalls,
			result.Usage.InputTokens, result.Usage.OutputTokens, result.FinalText)
	}

	if runErr != nil {
		fmt.Fprintf(stderr, "{{.Name}}: %v\n", runErr)
		return 1
	}
	if result.Stop != agentharness.StopCompleted {
		fmt.Fprintf(stderr, "{{.Name}}: run stopped without completing: %s\n", result.Stop)
		return 1
	}
	return 0
}

func main() {
	os.Exit(run(os.Args[1:], os.Stdout, os.Stderr, os.Getenv))
}
