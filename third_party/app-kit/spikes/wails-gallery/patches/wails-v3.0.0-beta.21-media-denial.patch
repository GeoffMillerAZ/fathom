+static NSString* httpOnlyEffectiveSecurityOrigin(WKSecurityOrigin* origin) {
+    if (origin == nil || origin.protocol == nil || origin.host == nil) {
+        return nil;
+    }
+    NSString* scheme = origin.protocol.lowercaseString;
+    if (![scheme isEqualToString:@"http"] && ![scheme isEqualToString:@"https"]) {
+        return nil;
+    }
+    NSString* host = origin.host.lowercaseString;
+    NSInteger port = origin.port;
+    if (port == 0) {
+        port = [scheme isEqualToString:@"https"] ? 443 : 80;
+    }
+    if (port < 1 || port > 65535) {
+        return nil;
+    }
+    if ([host containsString:@":"] && ![host hasPrefix:@"["]) {
+        host = [NSString stringWithFormat:@"[%@]", host];
+    }
+    return [NSString stringWithFormat:@"%@://%@:%ld", scheme, host, (long)port];
+}
