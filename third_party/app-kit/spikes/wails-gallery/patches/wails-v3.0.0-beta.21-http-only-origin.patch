+func TestNormaliseHTTPOnlyOrigin(t *testing.T) {
+	for _, tc := range []struct {
+		name, input, want string
+		invalid           bool
+	}{
+		{name: "disabled", input: "", want: ""},
+		{name: "http default port", input: "http://Example.COM", want: "http://example.com:80"},
+		{name: "https default port", input: "https://example.com/", want: "https://example.com:443"},
+		{name: "explicit loopback port", input: "http://127.0.0.1:54321", want: "http://127.0.0.1:54321"},
+		{name: "canonical port", input: "http://127.0.0.1:080", want: "http://127.0.0.1:80"},
+		{name: "ipv6", input: "http://[::1]:54321", want: "http://[::1]:54321"},
+		{name: "scheme", input: "file:///tmp/a", invalid: true},
+		{name: "userinfo", input: "http://user@example.com", invalid: true},
+		{name: "path", input: "http://example.com/app", invalid: true},
+		{name: "query", input: "http://example.com?x=1", invalid: true},
+		{name: "empty query", input: "http://example.com?", invalid: true},
+		{name: "fragment", input: "http://example.com#x", invalid: true},
+		{name: "missing host", input: "http:", invalid: true},
+		{name: "dangling port", input: "http://example.com:", invalid: true},
+		{name: "zero port", input: "http://example.com:0", invalid: true},
+		{name: "unicode host", input: "http://éxample.com", invalid: true},
+		{name: "ipv6 zone", input: "http://[fe80::1%25en0]", invalid: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := normaliseHTTPOnlyOrigin(tc.input)
+			if tc.invalid {
+				if err == nil {
+					t.Fatalf("normaliseHTTPOnlyOrigin(%q) = %q, want error", tc.input, got)
+				}
+				return
+			}
+			if err != nil || got != tc.want {
+				t.Fatalf("normaliseHTTPOnlyOrigin(%q) = %q, %v; want %q", tc.input, got, err, tc.want)
+			}
+		})
+	}
+}
 
