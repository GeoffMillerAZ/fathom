+func normaliseHTTPOnlyOrigin(raw string) (string, error) {
+	if raw == "" {
+		return "", nil
+	}
+	u, err := url.Parse(raw)
+	if err != nil {
+		return "", fmt.Errorf("invalid HTTP-only origin: %w", err)
+	}
+	scheme := strings.ToLower(u.Scheme)
+	if (scheme != "http" && scheme != "https") || u.Opaque != "" || u.User != nil || u.Hostname() == "" ||
+		u.ForceQuery || u.RawQuery != "" || u.Fragment != "" || (u.EscapedPath() != "" && u.EscapedPath() != "/") || strings.HasSuffix(u.Host, ":") {
+		return "", fmt.Errorf("HTTP-only origin must contain only an http(s) scheme and host")
+	}
+	host := strings.ToLower(u.Hostname())
+	for _, r := range host {
+		if r > 127 || r == '%' {
+			return "", fmt.Errorf("HTTP-only origin host must be an ASCII hostname or IP address")
+		}
+	}
+	port := u.Port()
+	if port == "" {
+		if scheme == "https" {
+			port = "443"
+		} else {
+			port = "80"
+		}
+	}
+	portNumber, err := strconv.Atoi(port)
+	if err != nil || portNumber < 1 || portNumber > 65535 {
+		return "", fmt.Errorf("HTTP-only origin must use a valid effective port")
+	}
+	return scheme + "://" + net.JoinHostPort(host, strconv.Itoa(portNumber)), nil
+}
+
