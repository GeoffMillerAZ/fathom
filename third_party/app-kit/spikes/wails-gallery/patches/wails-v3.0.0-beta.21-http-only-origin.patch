+static NSString* httpOnlyEffectiveOrigin(NSURL* url) {
+    if (url == nil || url.user != nil || url.password != nil || url.scheme == nil || url.host == nil) {
+        return nil;
+    }
+    NSString* scheme = url.scheme.lowercaseString;
+    if (![scheme isEqualToString:@"http"] && ![scheme isEqualToString:@"https"]) {
+        return nil;
+    }
+    NSString* host = url.host.lowercaseString;
+    NSNumber* port = url.port;
+    if (port == nil) {
+        port = [scheme isEqualToString:@"https"] ? @443 : @80;
+    }
+    if ([host containsString:@":"] && ![host hasPrefix:@"["]) {
+        host = [NSString stringWithFormat:@"[%@]", host];
+    }
+    return [NSString stringWithFormat:@"%@://%@:%@", scheme, host, port];
+}
+
+- (void)webView:(WKWebView *)webView decidePolicyForNavigationAction:(WKNavigationAction *)navigationAction
+    decisionHandler:(void (^)(WKNavigationActionPolicy))decisionHandler {
+    if (self.httpOnlyOrigin == nil) {
+        decisionHandler(WKNavigationActionPolicyAllow);
+        return;
+    }
+    WKFrameInfo* target = navigationAction.targetFrame;
+    WKFrameInfo* source = navigationAction.sourceFrame;
+    NSString* requestedOrigin = httpOnlyEffectiveOrigin(navigationAction.request.URL);
+    BOOL allowed = target != nil && target.isMainFrame && source != nil && source.isMainFrame &&
+        requestedOrigin != nil && [requestedOrigin isEqualToString:self.httpOnlyOrigin];
+    decisionHandler(allowed ? WKNavigationActionPolicyAllow : WKNavigationActionPolicyCancel);
 }
