+package webui_test
+
+import (
+	"context"
+	"crypto/subtle"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/geoffmilleraz/conjure/internal/doctor"
+	"github.com/geoffmilleraz/conjure/internal/domain"
+	"github.com/geoffmilleraz/conjure/internal/engine"
+	"github.com/geoffmilleraz/conjure/internal/webui"
+)
+
+// TestDashboardBrowserFixture is an opt-in, synthetic-only loopback target for
+// browser acceptance. It never constructs an engine or reads a machine root.
+func TestDashboardBrowserFixture(t *testing.T) {
+	if os.Getenv("APPKIT_CONJURE_BROWSER") != "1" {
+		t.Skip("set APPKIT_CONJURE_BROWSER=1 for the synthetic loopback fixture")
+	}
+
+	const token = "synthetic-session"
+	state := struct {
+		sync.Mutex
+		value         string
+		activeStreams int
+	}{value: "good"}
+	getState := func() string {
+		state.Lock()
+		defer state.Unlock()
+		return state.value
+	}
+	deps := webui.Deps{
+		Token: token, ReadOnly: true, Version: "synthetic-browser-fixture",
+		ConfigDir: "fixture-config", StateDir: "fixture-state", Hostname: "fixture-mac",
+		SourceFiles: func() ([]string, error) { return []string{"machine.cue"}, nil },
+		Status: func(context.Context) (*engine.Status, error) {
+			switch getState() {
+			case "good":
+				return syntheticDashboardStatus(3), nil
+			case "recovered":
+				return syntheticDashboardStatus(5), nil
+			case "empty":
+				return &engine.Status{}, nil
+			case "orphan":
+				return &engine.Status{Orphans: []domain.Orphan{{Unit: "file:old-zshrc", Detail: "synthetic orphan; no removal action"}}, Units: []engine.UnitStatus{{ID: "file:old-zshrc", State: "orphan"}}}, nil
+			case "failed":
+				return nil, errors.New("synthetic status failure: <script>alert('fixture')</script> & a very long untrusted detail that must wrap safely without creating markup or pretending the machine is empty")
+			default:
+				return nil, errors.New("invalid synthetic fixture state")
+			}
+		},
+		Doctor: func(context.Context) ([]doctor.Check, error) {
+			return []doctor.Check{{ID: "fixture", Name: "Synthetic read", Severity: doctor.SeverityOK}}, nil
+		},
+		Runs: func(context.Context) (*engine.RunsInfo, error) {
+			return &engine.RunsInfo{Entries: []engine.RunEntry{{At: time.Date(2026, 9, 21, 13, 0, 0, 0, time.UTC), Applied: 2}}}, nil
+		},
+		SnapshotSize:   func() (int64, error) { return 25 * 1024 * 1024, nil },
+		SnapshotBudget: func() int64 { return 100 * 1024 * 1024 },
+		Now: func() time.Time {
+			if getState() == "recovered" {
+				return time.Date(2026, 9, 21, 13, 6, 5, 0, time.UTC)
+			}
+			return time.Date(2026, 9, 21, 13, 4, 5, 0, time.UTC)
+		},
+	}
+	ui := webui.New(deps)
+	stop := make(chan struct{})
+	var stopOnce sync.Once
+	var origin string
+	allowedUI := map[string]bool{
+		"/": true, "/stream/dashboard": true, "/static/app.css": true,
+		"/assets/datastar.js": true, "/assets/overlay.js": true,
+	}
+	handler := http.HandlerFunc(func(rw http.ResponseWriter, r *http.Request) {
+		if r.Host != strings.TrimPrefix(origin, "http://") {
+			http.Error(rw, "forbidden host", http.StatusBadRequest)
+			return
+		}
+		if strings.HasPrefix(r.URL.Path, "/__fixture/") {
+			provided := r.Header.Get("X-Fixture-Token")
+			if provided == "" {
+				provided = r.URL.Query().Get("token")
+			}
+			if subtle.ConstantTimeCompare([]byte(provided), []byte(token)) != 1 {
+				http.Error(rw, "unauthorized fixture control", http.StatusUnauthorized)
+				return
+			}
+			if r.Method == http.MethodPost && r.Header.Get("Origin") != "" && r.Header.Get("Origin") != origin {
+				http.Error(rw, "forbidden origin", http.StatusForbidden)
+				return
+			}
+			switch {
+			case r.Method == http.MethodGet && r.URL.Path == "/__fixture/status":
+				state.Lock()
+				payload := struct {
+					State         string `json:"state"`
+					ActiveStreams int    `json:"active_streams"`
+				}{state.value, state.activeStreams}
+				state.Unlock()
+				rw.Header().Set("Content-Type", "application/json")
+				_ = json.NewEncoder(rw).Encode(payload)
+			case r.Method == http.MethodPost && r.URL.Path == "/__fixture/state":
+				value := r.URL.Query().Get("value")
+				switch value {
+				case "good", "failed", "empty", "orphan", "recovered":
+					state.Lock()
+					state.value = value
+					state.Unlock()
+					rw.WriteHeader(http.StatusNoContent)
+				default:
+					http.Error(rw, "unknown fixture state", http.StatusBadRequest)
+				}
+			case r.Method == http.MethodPost && r.URL.Path == "/__fixture/stop":
+				stopOnce.Do(func() { close(stop) })
+				rw.WriteHeader(http.StatusNoContent)
+			default:
+				http.NotFound(rw, r)
+			}
+			return
+		}
+		if r.Method != http.MethodGet || !allowedUI[r.URL.Path] {
+			http.Error(rw, "synthetic fixture is read-only", http.StatusForbidden)
+			return
+		}
+		if r.URL.Path == "/stream/dashboard" {
+			state.Lock()
+			state.activeStreams++
+			state.Unlock()
+			defer func() {
+				state.Lock()
+				state.activeStreams--
+				state.Unlock()
+			}()
+		}
+		ui.ServeHTTP(rw, r)
+	})
+	server := httptest.NewUnstartedServer(handler)
+	server.Start() // httptest selects a random 127.0.0.1 port.
+	origin = server.URL
+	t.Cleanup(func() {
+		server.CloseClientConnections()
+		server.Close()
+	})
+	fmt.Printf("APPKIT_FIXTURE_URL=%s\n", origin)
+	ctx, cancel := context.WithTimeout(context.Background(), 150*time.Second)
+	defer cancel()
+	select {
+	case <-stop:
+	case <-ctx.Done():
+		t.Log("synthetic browser fixture lifetime cap reached")
+	}
+}
+
+func syntheticDashboardStatus(n int) *engine.Status {
+	units := make([]engine.UnitStatus, n)
+	for i := range units {
+		units[i] = engine.UnitStatus{ID: domain.UnitID(fmt.Sprintf("file:fixture-%d", i+1)), State: "clean"}
+	}
+	return &engine.Status{Clean: n, Units: units}
+}
