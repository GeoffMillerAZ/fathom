+	"github.com/geoffmilleraz/conjure/internal/engine"
+)
+
+func dashboardValidityDeps(status func(context.Context) (*engine.Status, error)) Deps {
+	return Deps{
+		Token: "synthetic-session", Version: "test", ConfigDir: "fixture-config",
+		StateDir: "fixture-state", Hostname: "fixture-mac",
+		Status:         status,
+		Doctor:         func(context.Context) ([]doctor.Check, error) { return nil, nil },
+		Runs:           func(context.Context) (*engine.RunsInfo, error) { return &engine.RunsInfo{}, nil },
+		SnapshotSize:   func() (int64, error) { return 0, nil },
+		SnapshotBudget: func() int64 { return 100 },
+		SourceFiles:    func() ([]string, error) { return []string{"machine.cue"}, nil },
+	}
+}
+
+func TestCollectDashboardStatusUnavailableIsNotEmpty(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		status func(context.Context) (*engine.Status, error)
+		want   string
+	}{
+		{"error", func(context.Context) (*engine.Status, error) {
+			return &engine.Status{}, errors.New("synthetic status failure")
+		}, "synthetic status failure"},
+		{"nil_without_error", func(context.Context) (*engine.Status, error) { return nil, nil }, "status unavailable"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			w := &webui{deps: dashboardValidityDeps(tc.status)}
+			st, _, _, _, _, message := w.collectDashboardData(context.Background(), false)
+			if st != nil || !strings.Contains(message, tc.want) {
+				t.Fatalf("status=%v, message=%q; want nil status and %q", st, message, tc.want)
+			}
+		})
+	}
+}
+
+func TestDashboardStreamStateKeepsOnlyLastSuccessfulStatus(t *testing.T) {
+	first := time.Date(2026, 9, 21, 13, 4, 5, 0, time.UTC)
+	state := dashboardStreamState{}
+	for _, tc := range []struct {
+		name       string
+		status     *engine.Status
+		errorText  string
+		at         time.Time
+		wantPatch  bool
+		wantBanner string
+	}{
+		{"first_failure", nil, "Engine status failed: offline", first, true, "offline"},
+		{"first_success", &engine.Status{Clean: 1}, "", first, true, ""},
+		{"stale_failure", nil, "Engine status failed: offline", first.Add(time.Minute), false, "showing last good data from 13:04:05"},
+		{"recovery", &engine.Status{Clean: 2}, "", first.Add(2 * time.Minute), true, ""},
+		{"second_failure", nil, "Engine status failed: offline", first.Add(3 * time.Minute), false, "showing last good data from 13:06:05"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			patch, banner := state.resolve(tc.status, tc.errorText, tc.at)
+			if patch != tc.wantPatch || !strings.Contains(banner, tc.wantBanner) {
+				t.Fatalf("patch=%v banner=%q; want patch=%v banner containing %q", patch, banner, tc.wantPatch, tc.wantBanner)
+			}
+			if tc.wantBanner == "" && banner != "" {
+				t.Fatalf("success must clear banner, got %q", banner)
+			}
+		})
+	}
+}
+
+func TestDashboardInitialHandlerDoesNotClaimEmptyOnStatusFailure(t *testing.T) {
+	deps := dashboardValidityDeps(func(context.Context) (*engine.Status, error) {
+		return nil, errors.New("synthetic status failure")
+	})
+	h := New(deps)
+	r := httptest.NewRequest(http.MethodGet, "http://127.0.0.1/", nil)
+	r.AddCookie(&http.Cookie{Name: "conjure_session", Value: deps.Token})
+	rw := httptest.NewRecorder()
+	h.ServeHTTP(rw, r)
+	if rw.Code != http.StatusOK {
+		t.Fatalf("status %d, want 200", rw.Code)
+	}
+	body := rw.Body.String()
+	if !strings.Contains(body, "synthetic status failure") || strings.Contains(body, "No units declared") || strings.Contains(body, "No divergence detected") || strings.Contains(body, "converged —") {
+		t.Fatalf("failed status must show error without empty/converged claims: %s", body)
+	}
+}
+
+func TestDashboardInitialSSEUnavailableAndWholeFragments(t *testing.T) {
+	deps := dashboardValidityDeps(func(context.Context) (*engine.Status, error) {
+		return nil, errors.New("synthetic status failure")
+	})
+	h := New(deps)
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	r := httptest.NewRequest(http.MethodGet, "http://127.0.0.1/stream/dashboard", nil).WithContext(ctx)
+	r.AddCookie(&http.Cookie{Name: "conjure_session", Value: deps.Token})
+	pr, pw := io.Pipe()
+	rw := &dashboardValidityStreamWriter{writer: pw, header: make(http.Header)}
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		h.ServeHTTP(rw, r)
+		_ = pw.Close()
+	}()
+	t.Cleanup(func() {
+		cancel()
+		_ = pr.Close()
+		select {
+		case <-done:
+		case <-time.After(time.Second):
+			t.Error("dashboard SSE handler did not stop after cancellation")
+		}
+	})
+	var buf strings.Builder
+	chunk := make([]byte, 4096)
+	for !strings.Contains(buf.String(), "selector #dash-doctor") {
+		n, err := pr.Read(chunk)
+		buf.Write(chunk[:n])
+		if err != nil {
+			break
+		}
+	}
+	body := buf.String()
+	if !strings.HasPrefix(rw.header.Get("Content-Type"), "text/event-stream") || !strings.Contains(body, "synthetic status failure") || !strings.Contains(body, "Status unavailable") {
+		t.Fatalf("initial SSE must describe unavailable status: %s", body)
+	}
+	if strings.Contains(body, "No units declared") || strings.Contains(body, "No divergence detected") || strings.Contains(body, "converged —") {
+		t.Fatalf("unavailable SSE must not claim empty or converged: %s", body)
+	}
+	if !strings.Contains(body, `id="dash-stats"`) || !strings.Contains(body, `id="dash-feed"`) {
+		t.Fatalf("initial SSE must send complete id-bearing fragments: %s", body)
+	}
+}
+
+type dashboardValidityStreamWriter struct {
+	writer *io.PipeWriter
+	header http.Header
+}
+
+func (w *dashboardValidityStreamWriter) Header() http.Header { return w.header }
+func (w *dashboardValidityStreamWriter) WriteHeader(int)     {}
+func (w *dashboardValidityStreamWriter) Write(b []byte) (int, error) {
+	return w.writer.Write(b)
+}
+func (w *dashboardValidityStreamWriter) Flush() {}
+
+func TestDashboardSSEFailurePreservesLastGoodFragments(t *testing.T) {
+	status := &engine.Status{Clean: 1, Units: []engine.UnitStatus{{ID: "file:zshrc"}}}
+	var statusErr error
+	first := time.Date(2026, 9, 21, 13, 4, 5, 0, time.UTC)
+	deps := dashboardValidityDeps(func(context.Context) (*engine.Status, error) { return status, statusErr })
+	now := first
+	deps.Now = func() time.Time { return now }
+	w := &webui{deps: deps}
+	r := httptest.NewRequest(http.MethodGet, "http://127.0.0.1/stream/dashboard", nil)
+	rw := httptest.NewRecorder()
+	sse := datastar.NewSSE(rw, r)
+	state := dashboardStreamState{}
+	w.patchDashboard(sse, r.Context(), false, &state)
+	good := rw.Body.Len()
+	if !strings.Contains(rw.Body.String(), "converged — 1 unit") {
+		t.Fatalf("first success must patch status fragments: %s", rw.Body.String())
+	}
+	status, statusErr = nil, errors.New("synthetic outage")
+	w.patchDashboard(sse, r.Context(), false, &state)
+	failurePatch := rw.Body.String()[good:]
+	if !strings.Contains(failurePatch, "showing last good data from 13:04:05") || strings.Contains(failurePatch, `id="dash-stats"`) || strings.Contains(failurePatch, `id="dash-feed"`) {
+		t.Fatalf("failure must patch banner only, retaining last good status: %s", failurePatch)
+	}
+	status, statusErr = &engine.Status{Clean: 2, Units: []engine.UnitStatus{{ID: "brew:ripgrep"}}}, nil
+	now = first.Add(2 * time.Minute)
+	w.patchDashboard(sse, r.Context(), false, &state)
+	recoveryPatch := rw.Body.String()[good+len(failurePatch):]
+	if !strings.Contains(recoveryPatch, "converged — 2 units") || !strings.Contains(recoveryPatch, `id="dash-stats"`) || strings.Contains(recoveryPatch, "synthetic outage") {
+		t.Fatalf("recovery must clear failure and refresh status: %s", recoveryPatch)
+	}
+	status, statusErr = nil, errors.New("synthetic second outage")
+	w.patchDashboard(sse, r.Context(), false, &state)
+	secondFailure := rw.Body.String()[good+len(failurePatch)+len(recoveryPatch):]
+	if !strings.Contains(secondFailure, "showing last good data from 13:06:05") || strings.Contains(secondFailure, `id="dash-stats"`) {
+		t.Fatalf("second failure must retain recovered sample and its timestamp: %s", secondFailure)
+	}
+}
