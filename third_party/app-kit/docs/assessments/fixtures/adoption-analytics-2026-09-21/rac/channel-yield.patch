diff --git a/cmd/serve/analytics_export.go b/cmd/serve/analytics_export.go
new file mode 100644
index 0000000..a381bd2
--- /dev/null
+++ b/cmd/serve/analytics_export.go
@@ -0,0 +1,60 @@
+package serve
+
+import (
+	"bytes"
+	"encoding/csv"
+	"strconv"
+	"strings"
+	"unicode"
+
+	"github.com/geoffmilleraz/resume-as-code/cmd/metrics"
+	"github.com/geoffmilleraz/resume-as-code/cmd/ops"
+	"github.com/geoffmilleraz/resume-as-code/cmd/tracker"
+)
+
+// channelYieldCSV exports the same ops projection as the Pipeline and People
+// widgets. This is an aggregate, not the historical application-level export.
+func channelYieldCSV(reg *tracker.Registry) ([]byte, error) {
+	var out bytes.Buffer
+	w := csv.NewWriter(&out)
+	w.Write([]string{"channel", "applications_count", "applied_count", "responded_count", "interviews_count", "offers_count", "outcomes_without_applied_count", "response_rate", "interview_rate", "cohort_status", "minimum_applied_for_rate", "source", "scope", "freshness", "channel_rule", "outcome_rule"})
+	for _, row := range ops.ChannelYield(reg) {
+		status := "ready"
+		switch {
+		case row.OutcomeWithoutApplied > 0:
+			status = "incomplete-sent-evidence"
+		case row.Apps == 0:
+			status = "no-applications"
+		case row.Applied < metrics.DefaultRateFloor:
+			status = "below-minimum-applied"
+		}
+		values := []string{
+			string(row.Channel), strconv.Itoa(row.Apps), strconv.Itoa(row.Applied),
+			strconv.Itoa(row.Responded), strconv.Itoa(row.Interviews), strconv.Itoa(row.Offers),
+			strconv.Itoa(row.OutcomeWithoutApplied),
+			row.ResponseRate.RenderFloored(metrics.DefaultRateFloor),
+			row.InterviewRate.RenderFloored(metrics.DefaultRateFloor),
+			status, strconv.Itoa(metrics.DefaultRateFloor),
+			"stored application registry", "all recorded applications; no date filter; closed included",
+			"source freshness not independently verified",
+			"referral contact > firm attribution or executive-search contact > sent/replied campaign > cold-apply",
+			"applied date or applied transition; response from replied touch or screening/interview/offer transition; interview from interview transition",
+		}
+		for i := range values {
+			values[i] = formulaSafeCSVCell(values[i])
+		}
+		w.Write(values)
+	}
+	w.Flush()
+	return out.Bytes(), w.Error()
+}
+
+// CSV quoting is not spreadsheet formula protection. Prefix a risky leading
+// formula character even when preceding whitespace would conceal it.
+func formulaSafeCSVCell(value string) string {
+	first := strings.TrimLeftFunc(value, unicode.IsSpace)
+	if first != "" && strings.ContainsRune("=+-@", []rune(first)[0]) {
+		return "'" + value
+	}
+	return value
+}
