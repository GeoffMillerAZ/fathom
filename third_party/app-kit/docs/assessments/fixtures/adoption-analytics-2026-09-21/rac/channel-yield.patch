+func TestCandidateChannelYieldZeroIsNotMissingAndLegacyJSONRemains(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		reg  *tracker.Registry
+		want []string
+		ui   string
+	}{
+		{"no-records", &tracker.Registry{Version: 1}, []string{"cold-apply", "0", "0", "0", "0", "0", "0", "not enough outcomes yet (n=0, need 5)", "not enough outcomes yet (n=0, need 5)", "no-applications"}, "No application history yet."},
+		{"measured-zero", candidateFiveSentNoResponse(), []string{"cold-apply", "5", "5", "0", "0", "0", "0", "0%", "0%", "ready"}, "Response: 0% (0/5)."},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			s := serverWithRegistry(t, tc.reg)
+			rec := httptest.NewRecorder()
+			s.handleExport(rec, httptest.NewRequest(http.MethodGet, "/api/export?format=csv&view=channel-yield", nil))
+			if rec.Code != http.StatusOK || rec.Header().Get("Content-Type") != "text/csv; charset=utf-8" ||
+				rec.Header().Get("Content-Disposition") != `attachment; filename="channel-yield.csv"` {
+				t.Fatalf("CSV HTTP contract: status=%d headers=%v", rec.Code, rec.Header())
+			}
+			rows, err := csv.NewReader(strings.NewReader(rec.Body.String())).ReadAll()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(rows) != 5 || !reflect.DeepEqual(rows[1][:10], tc.want) {
+				t.Fatalf("aggregate zero semantics: rows=%q, want first row=%q", rows, tc.want)
+			}
+			widget := pipelineChannelWidgetHTML(tc.reg)
+			if !strings.Contains(widget, tc.ui) {
+				t.Errorf("UI must distinguish absent data from measured zero: want %q", tc.ui)
+			}
+			if !strings.Contains(widget, `href="/api/export?format=csv&amp;view=channel-yield"`) {
+				t.Error("owning widget must expose the aggregate export in every state")
+			}
+		})
+	}
+
+	s := serverWithRegistry(t, candidateFiveSentNoResponse())
+	rec := httptest.NewRecorder()
+	s.handleExport(rec, httptest.NewRequest(http.MethodGet, "/api/export?format=json", nil))
+	if rec.Code != http.StatusOK || rec.Header().Get("Content-Disposition") != `attachment; filename="pipeline.json"` ||
+		!strings.Contains(rec.Body.String(), `"applications"`) {
+		t.Fatalf("legacy JSON export changed: status=%d headers=%v", rec.Code, rec.Header())
+	}
+}
+
+func candidateFiveSentNoResponse() *tracker.Registry {
+	reg := &tracker.Registry{Version: 1}
+	for i := 0; i < 5; i++ {
+		reg.Applications = append(reg.Applications, tracker.Application{
+			ID: "fictional-sent-" + itoa(i), Company: "Example Synthetic", Role: "Engineer",
+			Status: tracker.StatusApplied, CreatedDate: "2099-01-15", AppliedDate: "2099-01-15",
+		})
+	}
+	return reg
+}
+
+// Fixed before benchmarking: five fictional sent applications per canonical
+// channel, with 0/1/2/3 responses and 0/0/1/2 interviews respectively.
+func candidateTwentyChannelFixture() *tracker.Registry {
+	reg := &tracker.Registry{Version: 1}
+	for channel := 0; channel < 4; channel++ {
+		for n := 0; n < 5; n++ {
+			a := tracker.Application{
+				ID:      "fictional-" + strconv.Itoa(channel) + "-" + strconv.Itoa(n),
+				Company: "Example Synthetic", Role: "Engineer",
+				Status: tracker.StatusApplied, CreatedDate: "2099-01-15", AppliedDate: "2099-01-15",
+			}
+			switch channel {
+			case 1:
+				a.Campaign = &tracker.Campaign{Touches: []tracker.Touch{{N: 1, State: tracker.TouchSent}}}
+			case 2:
+				a.Contacts = []tracker.Contact{{Kind: tracker.ContactReferral}}
+			case 3:
+				a.Contacts = []tracker.Contact{{Kind: tracker.ContactExecSearch}}
+			}
+			if n < channel {
+				a.History = append(a.History, tracker.StatusEvent{To: tracker.StatusScreening})
+			}
+			if n < channel-1 {
+				a.History = append(a.History, tracker.StatusEvent{To: tracker.StatusInterview})
+			}
+			reg.Applications = append(reg.Applications, a)
+		}
+	}
+	return reg
+}
+
+func TestCandidateChannelYieldTwentyRecordFourRowAgreementAndBytes(t *testing.T) {
+	reg := candidateTwentyChannelFixture()
+	if len(reg.Applications) != 20 {
+		t.Fatal("benchmark/acceptance fixture must have exactly 20 fictional records")
+	}
+	widget := pipelineChannelWidgetHTML(reg)
+	csvBytes, err := channelYieldCSV(reg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(widget) > 16<<10 || len(csvBytes) > 8<<10 {
+		t.Fatalf("predeclared bytes exceeded: widget=%d/16384 CSV=%d/8192", len(widget), len(csvBytes))
+	}
+	if !strings.Contains(widget, `href="/api/export?format=csv&amp;view=channel-yield"`) {
+		t.Fatal("20-record widget lacks its aggregate export")
+	}
+	chart := regexp.MustCompile(`(?s)<svg\b.*?</svg>`).FindString(widget)
+	texts := regexp.MustCompile(`<text\b[^>]*>([^<]*)</text>`).FindAllStringSubmatch(chart, -1)
+	var gotChart []string
+	for _, text := range texts {
+		gotChart = append(gotChart, text[1])
+	}
+	wantChart := []string{"cold-apply", "5", "outreach", "5", "referral", "5", "firm", "5"}
+	if !reflect.DeepEqual(gotChart, wantChart) {
+		t.Fatalf("chart = %q, want %q", gotChart, wantChart)
+	}
+	wantRows := [][]string{
+		{"cold-apply", "5", "5", "0", "0", "0", "0", "0%", "0%", "ready"},
+		{"outreach", "5", "5", "1", "0", "0", "0", "20%", "0%", "ready"},
+		{"referral", "5", "5", "2", "1", "0", "0", "40%", "20%", "ready"},
+		{"firm", "5", "5", "3", "2", "0", "0", "60%", "40%", "ready"},
+	}
+	rows, err := csv.NewReader(strings.NewReader(string(csvBytes))).ReadAll()
+	if err != nil || len(rows) != 5 {
+		t.Fatalf("four-channel CSV rows=%d error=%v", len(rows), err)
+	}
+	wantHeader := []string{"channel", "applications_count", "applied_count", "responded_count", "interviews_count", "offers_count", "outcomes_without_applied_count", "response_rate", "interview_rate", "cohort_status", "minimum_applied_for_rate", "source", "scope", "freshness", "channel_rule", "outcome_rule"}
+	if !reflect.DeepEqual(rows[0], wantHeader) {
+		t.Fatalf("CSV header=%q", rows[0])
+	}
+	for i, want := range wantRows {
+		got := rows[i+1]
+		if len(got) != len(wantHeader) || !reflect.DeepEqual(got[:10], want) {
+			t.Errorf("CSV row %d=%q, want prefix %q", i, got, want)
+			continue
+		}
+		if got[10] != "5" || got[11] != "stored application registry" ||
+			got[12] != "all recorded applications; no date filter; closed included" ||
+			got[13] != "source freshness not independently verified" ||
+			!strings.Contains(got[14], "referral contact") || !strings.Contains(got[15], "applied date") {
+			t.Errorf("CSV row %d lost rate floor/source/scope/freshness/rules: %q", i, got[10:])
+		}
+		tableRow := `<th scope="row" class="py-2 pr-2 text-left font-normal">` + want[0] +
+			`</th><td class="py-2 pr-2 tabular-nums">5</td><td class="py-2 pr-2 tabular-nums">` + want[3] +
+			`</td><td class="py-2 tabular-nums">` + want[4] + `</td>`
+		if !strings.Contains(widget, tableRow) {
+			t.Errorf("widget table row %d differs from CSV", i)
+		}
+		if !strings.Contains(widget, "Response: "+want[7]+" ("+want[3]+"/5). Interview: "+want[8]+" ("+want[4]+"/5).") {
+			t.Errorf("widget rate row %d differs from CSV", i)
+		}
+	}
+	t.Logf("20-record pure widget=%d bytes CSV=%d bytes", len(widget), len(csvBytes))
+}
+
+var candidateBenchmarkWidget string
+var candidateBenchmarkCSV []byte
+
+func BenchmarkCandidateChannelYieldWidgetCSV20(b *testing.B) {
+	reg := candidateTwentyChannelFixture()
+	b.ReportAllocs()
+	var before, after runtime.MemStats
+	runtime.ReadMemStats(&before)
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		candidateBenchmarkWidget = pipelineChannelWidgetHTML(reg)
+		var err error
+		candidateBenchmarkCSV, err = channelYieldCSV(reg)
+		if err != nil {
+			b.Fatal(err)
+		}
+	}
+	b.StopTimer()
+	runtime.ReadMemStats(&after)
+	b.ReportMetric(float64(len(candidateBenchmarkWidget)), "widget-bytes/op")
+	b.ReportMetric(float64(len(candidateBenchmarkCSV)), "csv-bytes/op")
+	if elapsed := b.Elapsed() / time.Duration(b.N); elapsed > 5*time.Millisecond {
+		b.Errorf("pure widget+CSV %s/op exceeds predeclared 5ms/op", elapsed)
+	}
+	if allocated := int64(after.TotalAlloc-before.TotalAlloc) / int64(b.N); allocated > 512<<10 {
+		b.Errorf("pure widget+CSV %d B/op exceeds predeclared 512KiB/op", allocated)
+	}
+}
