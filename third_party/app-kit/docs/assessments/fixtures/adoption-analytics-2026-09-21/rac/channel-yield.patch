+// This is an overlay-only, fictional-data oracle, not a production fixture.
+func TestCandidateChannelYieldChartTableAndExportBoundary(t *testing.T) {
+	reg := pipelineOutcomeFixture()
+	widget := pipelineChannelWidgetHTML(reg)
+	chart := regexp.MustCompile(`(?s)<svg\b.*?</svg>`).FindString(widget)
+	if chart == "" {
+		t.Fatal("channel-yield chart missing")
+	}
+	texts := regexp.MustCompile(`<text\b[^>]*>([^<]*)</text>`).FindAllStringSubmatch(chart, -1)
+	var gotChart []string
+	for _, match := range texts {
+		gotChart = append(gotChart, match[1])
+	}
+	wantChart := []string{"cold-apply", "5", "outreach", "0", "referral", "0", "firm", "0"}
+	if !reflect.DeepEqual(gotChart, wantChart) {
+		t.Fatalf("SVG label/value sequence = %q, want %q", gotChart, wantChart)
+	}
+	for _, row := range []string{
+		`<th scope="row" class="py-2 pr-2 text-left font-normal">cold-apply</th><td class="py-2 pr-2 tabular-nums">5</td><td class="py-2 pr-2 tabular-nums">4</td><td class="py-2 tabular-nums">2</td>`,
+		`<th scope="row" class="py-2 pr-2 text-left font-normal">outreach</th><td class="py-2 pr-2 tabular-nums">0</td>`,
+		`<th scope="row" class="py-2 pr-2 text-left font-normal">referral</th><td class="py-2 pr-2 tabular-nums">0</td>`,
+		`<th scope="row" class="py-2 pr-2 text-left font-normal">firm</th><td class="py-2 pr-2 tabular-nums">0</td>`,
+	} {
+		if !strings.Contains(widget, row) {
+			t.Errorf("native table lacks known-value row %q", row)
+		}
+	}
+	if !strings.Contains(widget, "80% (4/5)") || !strings.Contains(widget, "40% (2/5)") {
+		t.Error("known-value response/interview denominators missing")
+	}
+	if !strings.Contains(widget, `href="/api/export?format=csv&amp;view=channel-yield"`) {
+		t.Error("channel-yield export is not linked from its owning widget")
+	}
+
+	s := serverWithRegistry(t, reg)
+	rec := httptest.NewRecorder()
+	s.handleExport(rec, httptest.NewRequest(http.MethodGet, "/api/export?format=csv", nil))
+	if rec.Code != http.StatusOK {
+		t.Fatalf("raw registry export status %d", rec.Code)
+	}
+	rows, err := csv.NewReader(strings.NewReader(rec.Body.String())).ReadAll()
+	if err != nil {
+		t.Fatal(err)
+	}
+	wantHeader := []string{"id", "company", "role", "status", "fit", "applied", "location", "remote", "reviewed", "emails", "jobURL"}
+	if len(rows) != 6 || !reflect.DeepEqual(rows[0], wantHeader) {
+		t.Fatalf("raw registry export unexpectedly changed: header=%q rows=%d", rows[0], len(rows))
+	}
+	// The default application-level export must remain distinct from the
+	// opt-in aggregate projection checked below.
+}
+
+func TestCandidateChannelYieldCSVAgreesWithRendererAndRefusesBrokenCohort(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		reg  func() *tracker.Registry
+		want []string // first data row, exact oracle authored from fictional inputs
+	}{
+		{"coherent", pipelineOutcomeFixture, []string{"cold-apply", "5", "5", "4", "2", "0", "0", "80%", "40%", "ready"}},
+		{"disjoint", pipelineIncompleteFixture, []string{"cold-apply", "6", "5", "1", "1", "0", "1", "rate unavailable: outcome missing applied evidence", "rate unavailable: outcome missing applied evidence", "incomplete-sent-evidence"}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			reg := tc.reg()
+			s := serverWithRegistry(t, reg)
+			rec := httptest.NewRecorder()
+			s.handleExport(rec, httptest.NewRequest(http.MethodGet, "/api/export?format=csv&view=channel-yield", nil))
+			if rec.Code != http.StatusOK {
+				t.Fatalf("analytics export status %d: %s", rec.Code, rec.Body.String())
+			}
+			if got := rec.Header().Get("Content-Disposition"); got != `attachment; filename="channel-yield.csv"` {
+				t.Fatalf("download filename = %q", got)
+			}
+			rows, err := csv.NewReader(strings.NewReader(rec.Body.String())).ReadAll()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(rows) != 5 || len(rows[0]) != 16 {
+				t.Fatalf("four-channel CSV shape = %d rows, %d fields", len(rows), len(rows[0]))
+			}
+			if !reflect.DeepEqual(rows[1][:10], tc.want) {
+				t.Errorf("first aggregate row = %q, want %q", rows[1][:10], tc.want)
+			}
+			if rows[1][10] != "5" || rows[1][11] != "stored application registry" ||
+				!strings.Contains(rows[1][12], "no date filter") || rows[1][13] != "source freshness not independently verified" ||
+				!strings.Contains(rows[1][14], "referral contact") || !strings.Contains(rows[1][15], "applied date") {
+				t.Error("floor, scope, attribution or source disclosure absent from CSV")
+			}
+			widget := pipelineChannelWidgetHTML(reg)
+			uiRate := tc.want[7]
+			if tc.name == "disjoint" {
+				uiRate = "Rates unavailable: incomplete sent evidence."
+			}
+			if !strings.Contains(widget, `>5</td>`) || !strings.Contains(widget, uiRate) {
+				t.Error("download does not agree with the selected renderer's applied count and rate")
+			}
+		})
+	}
+	for _, in := range []string{"=1+1", " +SUM(A1)", "\t@cmd", "-1"} {
+		if got := formulaSafeCSVCell(in); !strings.HasPrefix(got, "'") {
+			t.Errorf("formula-like CSV cell %q not neutralized: %q", in, got)
+		}
+	}
+	if got := formulaSafeCSVCell("stored application registry"); got != "stored application registry" {
+		t.Errorf("ordinary metadata changed: %q", got)
+	}
+}
