+++ b/cmd/fathom/appkit_analytics_acceptance_test.go
@@ -0,0 +1,174 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+// These probes seed the existing cache directly. They never construct a live
+// model, read logs/registry/user files, or contact a running daemon.
+func appkitTrafficModel() observatoryModel {
+	m := syntheticModel()
+	base := m.Services[0]
+	m.Services = nil
+	for i, id := range []string{"alpha", "beta", "gamma"} {
+		row := base
+		row.Service, row.Path = id, "/synthetic/"+id
+		row.Freshness, row.FreshnessRemedy = "fresh", ""
+		row.CallsTotal = []int{10, 8, 0}[i]
+		row.CallsAgent = []int{7, 0, 0}[i]
+		m.Services = append(m.Services, row)
+	}
+	return m
+}
+
+func seedAppkitTrafficCache(t *testing.T, m observatoryModel) {
+	t.Helper()
+	obsCache.Lock()
+	previous, at := obsCache.model, obsCache.at
+	// Future time makes an unexpectedly slow test unable to fall through to
+	// the live builder. This helper is deliberately never run in parallel.
+	obsCache.model, obsCache.at = m, time.Now().Add(time.Hour)
+	obsCache.Unlock()
+	t.Cleanup(func() {
+		obsCache.Lock()
+		obsCache.model, obsCache.at = previous, at
+		obsCache.Unlock()
+	})
+}
+
+func appkitTrafficRequest(t *testing.T, service bool, target string) *httptest.ResponseRecorder {
+	t.Helper()
+	h := observatoryHandler("http://127.0.0.1:1")
+	if service {
+		h = observatoryServicePage("http://127.0.0.1:1")
+	}
+	rec := httptest.NewRecorder()
+	h(rec, httptest.NewRequest(http.MethodGet, target, nil))
+	if rec.Code != http.StatusOK {
+		t.Fatalf("%s status %d", target, rec.Code)
+	}
+	return rec
+}
+
+func TestAppkitTrafficJourney(t *testing.T) {
+	cases := []struct {
+		name   string
+		mutate func(*observatoryModel)
+		want   string
+		chart  bool
+	}{
+		{"complete", func(*observatoryModel) {}, "7 of 10 recorded calls; current local call-log snapshot", true},
+		{"measured-zero-share", func(m *observatoryModel) { m.Services[0].CallsAgent = 0 }, "0 of 10 recorded calls; current local call-log snapshot", true},
+		{"empty-log", func(m *observatoryModel) { m.Services[0].CallsTotal, m.Services[0].CallsAgent = 0, 0 }, "no recorded calls for this service in the current log", false},
+		{"unreadable", func(m *observatoryModel) { m.CallLogNote = "synthetic call log unreadable" }, "not measured — synthetic call log unreadable", false},
+		{"partial-registry", func(m *observatoryModel) { m.DegradedNote = "synthetic registry partial: one service unavailable" }, "synthetic registry partial: one service unavailable", true},
+		{"stale-index", func(m *observatoryModel) { m.Services[0].Freshness = "stale: indexed abc, HEAD def" }, "stale: indexed abc, HEAD def", true},
+		{"recovered", func(*observatoryModel) {}, "7 of 10 recorded calls; current local call-log snapshot", true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			m := appkitTrafficModel()
+			tc.mutate(&m)
+			seedAppkitTrafficCache(t, m)
+			fleet := appkitTrafficRequest(t, false, "/observatory")
+			detail := appkitTrafficRequest(t, true, "/observatory/service?id=alpha")
+			body := detail.Body.String()
+			if !strings.Contains(body, tc.want) || !strings.Contains(body, m.GeneratedAt) {
+				t.Fatalf("detail lost expected value/validity/snapshot: %q", tc.want)
+			}
+			if got := strings.Contains(body, `id="service-agent-share"`); got != tc.chart {
+				t.Errorf("gauge present %v; want %v", got, tc.chart)
+			}
+			if tc.name == "complete" || tc.name == "recovered" {
+				for _, want := range []string{"7/10", ">70%<"} {
+					if !strings.Contains(body, want) {
+						t.Errorf("chart/text missing %q", want)
+					}
+				}
+			}
+			if !strings.Contains(fleet.Body.String(), "/observatory/service?id=alpha") {
+				t.Error("fleet lost alpha drill-down")
+			}
+			export := appkitTrafficRequest(t, false, "/observatory?format=json")
+			var got observatoryModel
+			if err := json.Unmarshal(export.Body.Bytes(), &got); err != nil {
+				t.Fatal(err)
+			}
+			if len(got.Services) != 3 || got.Services[0].CallsTotal != m.Services[0].CallsTotal || got.Services[0].CallsAgent != m.Services[0].CallsAgent {
+				t.Fatal("fleet export disagrees with selected recorded counts")
+			}
+			if got.CallLogNote != m.CallLogNote || got.DegradedNote != m.DegradedNote || got.GeneratedAt != m.GeneratedAt {
+				t.Error("fleet export lost validity/scope/snapshot")
+			}
+			if !strings.HasPrefix(export.Header().Get("Content-Type"), "application/json") {
+				t.Error("JSON content type lost")
+			}
+			if fleet.Body.Len() > 64*1024 || detail.Body.Len() > 64*1024 || export.Body.Len() > 32*1024 {
+				t.Errorf("payload budget exceeded: fleet=%d detail=%d json=%d", fleet.Body.Len(), detail.Body.Len(), export.Body.Len())
+			}
+			t.Logf("serialized bytes fleet=%d detail=%d json=%d; CSS/browser/network excluded", fleet.Body.Len(), detail.Body.Len(), export.Body.Len())
+		})
+	}
+}
+
+// Negative control: a service-scoped export must not discard the outer model's
+// validity and snapshot. The c58adaa endpoint failed this probe before the
+// candidate's additive metadata repair. This does not authorize active migration.
+func TestAppkitTrafficServiceExportRetainsValidity(t *testing.T) {
+	m := appkitTrafficModel()
+	m.CallLogNote = "synthetic call log unreadable"
+	m.Services[0].CallsTotal, m.Services[0].CallsAgent = 0, 0
+	seedAppkitTrafficCache(t, m)
+	rec := appkitTrafficRequest(t, true, "/observatory/service?id=alpha&format=json")
+	var got map[string]any
+	if err := json.Unmarshal(rec.Body.Bytes(), &got); err != nil {
+		t.Fatal(err)
+	}
+	if got["call_log_note"] != m.CallLogNote || got["generated_at"] != m.GeneratedAt {
+		t.Fatal("service JSON drops call-log validity and snapshot; unreadable zero cannot be distinguished from measured zero")
+	}
+	var legacy obsServiceRow
+	if err := json.Unmarshal(rec.Body.Bytes(), &legacy); err != nil {
+		t.Fatal(err)
+	}
+	if legacy.Service != "alpha" || legacy.Path != "/synthetic/alpha" || legacy.CallsTotal != 0 || legacy.CallsAgent != 0 {
+		t.Fatal("additive validity repair changed legacy flat service fields")
+	}
+}
+
+func TestAppkitTrafficMethodAndUnknownService(t *testing.T) {
+	seedAppkitTrafficCache(t, appkitTrafficModel())
+	for _, service := range []bool{false, true} {
+		h := observatoryHandler("http://127.0.0.1:1")
+		if service {
+			h = observatoryServicePage("http://127.0.0.1:1")
+		}
+		rec := httptest.NewRecorder()
+		h(rec, httptest.NewRequest(http.MethodPost, "/observatory/service?id=alpha", nil))
+		if rec.Code != http.StatusMethodNotAllowed {
+			t.Fatalf("POST = %d", rec.Code)
+		}
+	}
+	rec := httptest.NewRecorder()
+	observatoryServicePage("http://127.0.0.1:1")(rec, httptest.NewRequest(http.MethodGet, "/observatory/service?id=not-in-fixture", nil))
+	if rec.Code != http.StatusNotFound {
+		t.Fatalf("unknown service = %d", rec.Code)
+	}
+}
+
+var appkitTrafficRenderSink string
+
+func BenchmarkAppkitTrafficRender(b *testing.B) {
+	m := appkitTrafficModel()
+	b.ReportAllocs()
+	for b.Loop() {
+		fleet := obsPage("fathom observatory", "fleet", renderObsFleet(m), m)
+		detail, _ := renderObsService(m, "alpha")
+		appkitTrafficRenderSink = fleet + obsPage("fathom alpha", "fleet", detail, m)
+	}
+}
