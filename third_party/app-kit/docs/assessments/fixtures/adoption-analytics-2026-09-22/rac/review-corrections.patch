+func TestCandidateChannelYieldRejectsNonCSVFormat(t *testing.T) {
+	s := serverWithRegistry(t, candidateFiveSentNoResponse())
+	for _, path := range []string{
+		"/api/export?view=channel-yield",
+		"/api/export?view=channel-yield&format=json",
+	} {
+		rec := httptest.NewRecorder()
+		s.handleExport(rec, httptest.NewRequest(http.MethodGet, path, nil))
+		if rec.Code != http.StatusBadRequest || !strings.Contains(rec.Body.String(), "channel-yield export requires CSV") {
+			t.Errorf("%s: status=%d body=%q; want explicit CSV rejection", path, rec.Code, rec.Body.String())
+		}
+	}
+	for _, path := range []string{
+		"/api/export?view=unknown&format=csv",
+		"/api/export?view=unknown&format=json",
+	} {
+		rec := httptest.NewRecorder()
+		s.handleExport(rec, httptest.NewRequest(http.MethodGet, path, nil))
+		if rec.Code != http.StatusBadRequest || !strings.Contains(rec.Body.String(), "unknown export view") {
+			t.Errorf("%s: status=%d body=%q; want unknown-view rejection", path, rec.Code, rec.Body.String())
+		}
 	}
 }
 
