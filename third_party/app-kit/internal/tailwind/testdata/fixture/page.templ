// Conformance fixture: a templ page exercising kit token utilities. The
// end-to-end test builds CSS over this file and asserts the utilities and
// theme variables land in the output.
package fixture

templ Page() {
	<main class="bg-surface text-ink min-h-screen p-8">
		<section class="bg-surface-raised border border-line rounded-lg p-6">
			<h1 class="font-display text-2xl text-ink">Conformance</h1>
			<p class="text-ink-muted">The pipeline holds: tokens → theme → utilities.</p>
			<button class="bg-accent text-accent-ink hover:bg-accent-hover rounded-md px-4 py-2 focus-visible:outline-focus">
				Proceed
			</button>
			<span class="bg-positive-soft text-positive rounded-full px-2">ok</span>
			<div class="dark:border-line-strong"></div>
		</section>
	</main>
}
