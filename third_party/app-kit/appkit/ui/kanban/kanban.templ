package kanban

import (
	"fmt"
	"github.com/geoffmilleraz/fathom/third_party/app-kit/appkit/ui/card"
)

// Board renders a full kanban board.
//
// columns defines the stage lanes (order is preserved).
// cards are distributed into columns by StageID match.
// Cards with no matching column are silently omitted.
templ Board(columns []Column, cards []CardItem) {
	<div
		class="flex gap-4 overflow-x-auto pb-2"
		data-kanban-board
	>
		for _, col := range columns {
			@columnEl(col, cardsForStage(cards, col.ID))
		}
	</div>
}

// columnEl renders a single column lane.
templ columnEl(col Column, colCards []CardItem) {
	<div
		class="flex flex-col gap-2 min-w-[16rem] w-64 flex-shrink-0"
		data-kanban-col={ col.ID }
	>
		@columnHeader(col)
		<div class="flex flex-col gap-2 min-h-[4rem] rounded-lg bg-surface-sunken p-2">
			for _, c := range colCards {
				@cardEl(c)
			}
		</div>
	</div>
}

// columnHeader renders the column title + optional count badge.
templ columnHeader(col Column) {
	<div class="flex items-center justify-between px-1 py-1">
		<span class="text-xs font-sans font-semibold text-ink-muted uppercase tracking-wide">
			{ col.Label }
		</span>
		if col.Count >= 0 {
			<span class="text-xs font-mono text-ink-muted bg-surface-sunken rounded-full px-2 py-0.5 border border-line">
				{ fmt.Sprintf("%d", col.Count) }
			</span>
		}
	</div>
}

// cardEl renders a single card item, reusing the card.Card primitive.
templ cardEl(c CardItem) {
	<div
		class="cursor-grab active:cursor-grabbing"
		draggable="true"
		data-kanban-card={ c.ID }
	>
		@card.Card(card.Params{
			Body: cardBody(c),
		})
	</div>
}

// cardBody is the body slot component for a kanban card.
templ cardBody(c CardItem) {
	<div class="flex flex-col gap-1">
		if c.Title != "" {
			if c.Href != "" {
				<a
					href={ templ.SafeURL(c.Href) }
					class="text-sm font-sans font-medium text-ink leading-snug hover:text-neon-pink transition-colors"
				>{ c.Title }</a>
			} else {
				<p class="text-sm font-sans font-medium text-ink leading-snug">{ c.Title }</p>
			}
		}
		if c.Subtitle != "" {
			<p class="text-xs font-sans text-ink-muted">{ c.Subtitle }</p>
		}
		if len(c.Badges) > 0 {
			<div class="flex flex-wrap gap-1 mt-1">
				for _, b := range c.Badges {
					@badgeEl(b)
				}
			</div>
		}
		if c.Meta != "" {
			<p class="text-xs font-mono text-ink-faint mt-0.5">{ c.Meta }</p>
		}
	</div>
}

// badgeEl renders one badge chip using the badge's token role.
templ badgeEl(b Badge) {
	<span class={ badgeClass(b.Role) }>
		{ b.Label }
	</span>
}
