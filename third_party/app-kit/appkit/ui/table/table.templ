package table

import (
	"fmt"

	"github.com/geoffmilleraz/fathom/third_party/app-kit/appkit/ui/internal/webref"
)

// Table renders a generic data table. The scroll wrapper is positioned
// (relative) so it is the containing block for the absolutely positioned
// sr-only header labels: a table wider than a narrow screen scrolls inside the
// wrapper instead of letting a hidden label widen the whole document. Every
// header cell is a column header (scope="col"); the table has no row headers.
templ Table(p TableParams) {
	{{ p := withActionColumn(p) }}
	<div class="relative overflow-x-auto rounded-lg border border-line bg-surface-raised">
		<table
			class="w-full text-sm font-sans border-collapse"
			if p.TableID != "" {
				data-table={ p.TableID }
			}
		>
			if p.Caption != "" {
				<caption class="text-left text-xs text-ink-muted px-4 py-2 font-sans">
					{ p.Caption }
				</caption>
			}
			@tableHead(p)
			@tableBody(p)
			@tableFoot(p)
		</table>
	</div>
}

// tableHead renders the <thead> row.
templ tableHead(p TableParams) {
	<thead>
		<tr class="border-b border-line bg-surface-sunken">
			if p.Selectable {
				<th scope="col" class="w-10 px-3 py-2 text-left">
					<span class="sr-only">Select</span>
				</th>
			}
			for _, col := range p.Columns {
				<th scope="col" class={ thClass(col) }>
					if col.HeaderHTML != nil {
						@col.HeaderHTML
					} else if col.Sortable {
						<button
							type="button"
							class="inline-flex items-center gap-1 text-xs font-semibold text-ink-muted uppercase tracking-wide hover:text-ink"
							data-table-sort={ col.Key }
						>
							{ col.Label }
							@sortIcon(p.SortKey, p.SortDir, col.Key)
						</button>
					} else {
						<span class="text-xs font-semibold text-ink-muted uppercase tracking-wide">
							{ col.Label }
						</span>
					}
				</th>
			}
			if p.RowAction != nil || p.RowHrefs {
				<th scope="col" class="px-4 py-2 text-right">
					<span class="sr-only">Actions</span>
				</th>
			}
		</tr>
	</thead>
}

// tableBody renders the <tbody> rows.
templ tableBody(p TableParams) {
	<tbody class="divide-y divide-line">
		for i, row := range p.Rows {
			@tableRow(p, row, i)
		}
		if len(p.Rows) == 0 {
			@emptyRow(p)
		}
	</tbody>
}

// tableRow renders a single data row.
templ tableRow(p TableParams, row Row, idx int) {
	<tr
		class={ rowClass(idx, row) }
		data-table-row={ row.ID }
		if row.Activate {
			role="button"
			tabindex="0"
		}
		if row.Label != "" {
			aria-label={ row.Label }
		}
		{ row.Attrs... }
	>
		if p.Selectable {
			<td class="w-10 px-3 py-2">
				<input
					type="checkbox"
					class="rounded border-line text-accent focus-visible:outline-focus"
					data-table-select={ row.ID }
					aria-label={ fmt.Sprintf("Select row %s", row.ID) }
				/>
			</td>
		}
		for ci, col := range p.Columns {
			<td class={ tdClass(col) }>
				if c := htmlCell(row, ci); c != nil {
					@c
				} else {
					{ cellValue(row.Cells, ci) }
				}
			</td>
		}
		if p.RowAction != nil {
			<td class="px-4 py-2 text-right">
				@p.RowAction
			</td>
		} else if row.Href != "" {
			<td class="px-4 py-2 text-right">
				if webref.Allowed(row.Href) {
					<a
						href={ templ.SafeURL(row.Href) }
						class="inline-flex min-h-11 min-w-11 items-center justify-center text-xs font-medium text-accent hover:text-accent-hover transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
					>
						Open →
					</a>
				} else {
					<span role="link" aria-disabled="true" class="inline-flex min-h-11 min-w-11 items-center justify-center text-xs font-medium text-ink-muted">Open unavailable</span>
				}
			</td>
		} else if p.RowHrefs {
			<td class="px-4 py-2 text-right"></td>
		}
	</tr>
}

// emptyRow renders a "no data" row when Rows is empty.
templ emptyRow(p TableParams) {
	<tr>
		<td
			class="px-4 py-8 text-center text-sm text-ink-faint"
			colspan={ emptyColspan(p) }
		>
			No data
		</td>
	</tr>
}

// tableFoot renders the <tfoot> summary rows (subtotals, totals). Omitted when
// no Footer rows are supplied.
templ tableFoot(p TableParams) {
	if len(p.Footer) > 0 {
		<tfoot class="border-t border-line bg-surface-sunken">
			for _, fr := range p.Footer {
				<tr>
					for _, fc := range fr.Cells {
						<td class={ footerCellClass(fc) } colspan={ footerColspan(fc) }>
							if fc.HTML != nil {
								@fc.HTML
							} else {
								{ fc.Text }
							}
						</td>
					}
				</tr>
			}
		</tfoot>
	}
}

// sortIcon renders the active/inactive sort direction indicator.
templ sortIcon(activeSortKey, sortDir, colKey string) {
	if activeSortKey == colKey {
		if sortDir == "desc" {
			<span aria-hidden="true" class="text-accent">↓</span>
		} else {
			<span aria-hidden="true" class="text-accent">↑</span>
		}
	} else {
		<span aria-hidden="true" class="text-ink-faint opacity-50">↕</span>
	}
}
