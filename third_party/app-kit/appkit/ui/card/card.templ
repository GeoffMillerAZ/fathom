package card

// Card renders a generic card primitive with header/body/footer slots.
// All three slots are optional; pass nil to omit.
templ Card(p Params) {
	<div class={ cardClass(p) }>
		if p.Header != nil {
			<div class="px-5 py-3 border-b border-line">
				@p.Header
			</div>
		}
		<div class="px-5 py-4">
			if p.Body != nil {
				@p.Body
			}
		</div>
		if p.Footer != nil {
			<div class="px-5 py-3 border-t border-line">
				@p.Footer
			</div>
		}
	</div>
}

// SimpleCard renders a card from plain text title + description.
// Convenience wrapper over Card for cases where a full templ.Component slot is
// unnecessary — reused by the kanban package for titled card items.
templ SimpleCard(title, subtitle string) {
	@Card(Params{
		Body: simpleBody(title, subtitle),
	})
}

// simpleBody is an unexported helper slot for SimpleCard.
templ simpleBody(title, subtitle string) {
	if title != "" {
		<p class="text-sm font-sans font-medium text-ink leading-snug">{ title }</p>
	}
	if subtitle != "" {
		<p class="text-xs font-sans text-ink-muted mt-0.5">{ subtitle }</p>
	}
}
