<figure class="ak-vizframe rounded-lg border border-line bg-surface-raised p-4" id="spend-share" data-viz-carries="figure" data-viz-source="published" aria-describedby="spend-share-src"><figcaption class="mb-3 flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="text-sm font-semibold text-ink">Spend share by team</span><span class="text-xs text-ink-muted">FY25, all environments</span></figcaption><div class="ak-vizframe-body"><svg xmlns="http://www.w3.org/2000/svg" width="320" height="78" role="img" aria-label="spend share by team" viewBox="0 0 320 78"><title>spend share by team</title><text x="0" y="11" dominant-baseline="middle" fill="var(--ak-color-ink-muted)" font-size="11">platform</text><rect x="102" y="3.3" width="162" height="15.4" rx="3" fill="var(--ak-color-surface-sunken)" fill-opacity="0.5"/><rect x="102" y="3.3" width="77.76" height="15.4" rx="3" fill="var(--ak-color-accent)"><title>platform: 48%</title></rect><text x="320" y="11" text-anchor="end" dominant-baseline="middle" fill="var(--ak-color-ink)" font-size="11">48%</text><text x="0" y="39" dominant-baseline="middle" fill="var(--ak-color-ink-muted)" font-size="11">data</text><rect x="102" y="31.3" width="162" height="15.4" rx="3" fill="var(--ak-color-surface-sunken)" fill-opacity="0.5"/><rect x="102" y="31.3" width="50.22" height="15.4" rx="3" fill="var(--ak-color-info)"><title>data: 31%</title></rect><text x="320" y="39" text-anchor="end" dominant-baseline="middle" fill="var(--ak-color-ink)" font-size="11">31%</text><text x="0" y="67" dominant-baseline="middle" fill="var(--ak-color-ink-muted)" font-size="11">security</text><rect x="102" y="59.3" width="162" height="15.4" rx="3" fill="var(--ak-color-surface-sunken)" fill-opacity="0.5"/><rect x="102" y="59.3" width="34.02" height="15.4" rx="3" fill="var(--ak-color-positive)"><title>security: 21%</title></rect><text x="320" y="67" text-anchor="end" dominant-baseline="middle" fill="var(--ak-color-ink)" font-size="11">21%</text></svg></div><p cla