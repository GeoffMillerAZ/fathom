<form role="search" action="/search" method="get" class="flex flex-wrap items-end gap-2"><div class="min-w-0 flex-1 basis-60"><label for="cmd-page-input" class="block text-sm font-medium text-ink">Search</label><input id="cmd-page-input" name="q" type="search" value="orbit &#34;service&#34;" autocomplete="off" enterkeyhint="search" placeholder="Type to search" class="mt-1 block min-h-11 w-full rounded-md border border-line-strong bg-surface px-3 py-2 text-base text-ink placeholder:text-ink-muted sm:text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"></div><button type="submit" class="inline-flex min-h-11 items-center rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-ink hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus">Search</button></form>