<svg xmlns="http://www.w3.org/2000/svg" width="420" height="84" role="img" aria-label="reward vs cost" viewBox="0 0 420 84"><title>reward vs cost</title><line x1="258" y1="0" x2="258" y2="84" stroke="var(--ak-color-line)" stroke-width="1"/><text x="0" y="12" dominant-baseline="middle" fill="var(--ak-color-ink-muted)" font-size="11">habitability</text><rect x="253.95" y="4.8" width="4.05" height="14.4" rx="2" fill="var(--ak-color-caution)"><title>habitability cost: $240</title></rect><rect x="258" y="4.8" width="87.75" height="14.4" rx="2" fill="var(--ak-color-positive)"><title>habitability reward: $5200</title></rect><text x="0" y="42" dominant-baseline="middle" fill="var(--ak-color-ink-muted)" font-size="11">deposit</text><rect x="255.97" y="34.8" width="2.02" height="14.4" rx="2" fill="var(--ak-color-caution)"><title>deposit cost: $120</title></rect><rect x="258" y="34.8" width="40.5" height="14.4" rx="2" fill="var(--ak-color-positive)"><title>deposit reward: $2400</title></rect><text x="0" y="72" dominant-baseline="middle" fill="var(--ak-color-ink-muted)" font-size="11">trial path</text><rect x="232.69" y="64.8" width="25.31" height="14.4" rx="2" fill="var(--ak-color-caution)"><title>trial path cost: $1500</title></rect><rect x="258" y="64.8" width="162" height="14.4" rx="2" fill="var(--ak-color-positive)"><title>trial path reward: $9600</title></rect></svg>