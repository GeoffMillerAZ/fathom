<svg xmlns="http://www.w3.org/2000/svg" width="160" height="98" role="img" aria-label="funnel chart" viewBox="0 0 160 98"><title>funnel chart</title><rect x="0" y="0" width="72" height="20" rx="3" fill="var(--ak-color-info)"><title>proposed: 100</title></rect><text x="80" y="10" dominant-baseline="middle" fill="var(--ak-color-ink-muted)" font-size="11">proposed</text><text x="68" y="10" text-anchor="end" dominant-baseline="middle" fill="var(--ak-color-ink-inverse)" font-size="11" font-weight="500">100</text><rect x="0" y="26" width="51.84" height="20" rx="3" fill="var(--ak-color-accent)"><title>imported: 72</title></rect><text x="80" y="36" dominant-baseline="middle" fill="var(--ak-color-ink-muted)" font-size="11">imported</text><text x="47.84" y="36" text-anchor="end" dominant-baseline="middle" fill="var(--ak-color-ink-inverse)" font-size="11" font-weight="500">72</text><rect x="0" y="52" width="12.96" height="20" rx="3" fill="var(--ak-color-caution)"><title>excluded: 18</title></rect><text x="80" y="62" dominant-baseline="middle" fill="var(--ak-color-ink-muted)" font-size="11">excluded</text><text x="8.96" y="62" text-anchor="end" dominant-baseline="middle" fill="var(--ak-color-ink)" font-size="11" font-weight="500">18</text><rect x="0" y="78" width="38.88" height="20" rx="3" fill="var(--ak-color-positive)"><title>final: 54</title></rect><text x="80" y="88" dominant-baseline="middle" fill="var(--ak-color-ink-muted)" font-size="11">final</text><text x="34.88" y="88" text-anchor="end" dominant-baseline="middle" fill="var(--ak-color-ink-inverse)" font-size="11" font-weight="500">54</text></svg>