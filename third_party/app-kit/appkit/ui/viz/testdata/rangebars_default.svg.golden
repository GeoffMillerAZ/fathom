<svg xmlns="http://www.w3.org/2000/svg" width="360" height="90" role="img" aria-label="recovery ranges" viewBox="0 0 360 90"><title>recovery ranges</title><text x="0" y="13" dominant-baseline="middle" fill="var(--ak-color-ink-muted)" font-size="11">habitability</text><rect x="102" y="7.28" width="162" height="11.44" rx="3" fill="var(--ak-color-surface-sunken)" fill-opacity="0.5"/><rect x="140.88" y="7.28" width="116.64" height="11.44" rx="3" fill="var(--ak-color-positive)"><title>habitability: $2400 – $9600</title></rect><line x1="186.24" y1="4.68" x2="186.24" y2="21.32" stroke="var(--ak-color-ink)" stroke-width="2"><title>most likely: $5200</title></line><text x="360" y="13" text-anchor="end" dominant-baseline="middle" fill="var(--ak-color-ink)" font-size="10">$2400–$9600</text><text x="0" y="45" dominant-baseline="middle" fill="var(--ak-color-ink-muted)" font-size="11">deposit</text><rect x="102" y="39.28" width="162" height="11.44" rx="3" fill="var(--ak-color-surface-sunken)" fill-opacity="0.5"/><rect x="121.44" y="39.28" width="38.88" height="11.44" rx="3" fill="var(--ak-color-accent)"><title>deposit: $1200 – $3600</title></rect><line x1="140.88" y1="36.68" x2="140.88" y2="53.32" stroke="var(--ak-color-ink)" stroke-width="2"><title>most likely: $2400</title></line><text x="360" y="45" text-anchor="end" dominant-baseline="middle" fill="var(--ak-color-ink)" font-size="10">$1200–$3600</text><text x="0" y="77" dominant-baseline="middle" fill="var(--ak-color-ink-muted)" font-size="11">fees</text><rect x="102" y="71.28" width="162" height="11.44" rx="3" fill="var(--ak-color-surface-sunken)" fill-opacity="0.5"/><rect x="102" y="71.28" width="24.3" height="11.44" rx="3" fill="var(--ak-color-caution)"><title>fees: $0 – $1500</title></rect><text x="360" y="77" text-anchor="end" dominant-baseline="middle" fill="var(--ak-color-ink)" font-size="10">$0–$1500</text></svg>