<svg xmlns="http://www.w3.org/2000/svg" width="420" height="174" role="img" aria-label="combined recovery waterfall" viewBox="0 0 420 174"><title>combined recovery waterfall</title><line x1="8" y1="154" x2="412" y2="154" stroke="var(--ak-color-line)" stroke-width="1"/><rect x="21.47" y="58.21" width="40.4" height="95.79" rx="2" fill="var(--ak-color-positive)"><title>habitability: $5200</title></rect><line x1="61.87" y1="58.21" x2="88.8" y2="58.21" stroke="var(--ak-color-line-strong)" stroke-width="1" stroke-dasharray="2 2"/><text x="41.67" y="55.21" text-anchor="middle" fill="var(--ak-color-ink)" font-size="10">$5200</text><text x="41.67" y="166" text-anchor="middle" fill="var(--ak-color-ink-muted)" font-size="10">habitability</text><rect x="88.8" y="14" width="40.4" height="44.21" rx="2" fill="var(--ak-color-positive)"><title>deposit: $2400</title></rect><line x1="129.2" y1="14" x2="156.13" y2="14" stroke="var(--ak-color-line-strong)" stroke-width="1" stroke-dasharray="2 2"/><text x="109" y="11" text-anchor="middle" fill="var(--ak-color-ink)" font-size="10">$2400</text><text x="109" y="166" text-anchor="middle" fill="var(--ak-color-ink-muted)" font-size="10">deposit</text><rect x="156.13" y="14" width="40.4" height="33.16" rx="2" fill="var(--ak-color-danger)"><title>overlap: $-1800</title></rect><text x="176.33" y="11" text-anchor="middle" fill="var(--ak-color-ink)" font-size="10">$-1800</text><text x="176.33" y="166" text-anchor="middle" fill="var(--ak-color-ink-muted)" font-size="10">overlap</text><rect x="223.47" y="47.16" width="40.4" height="106.84" rx="2" fill="var(--ak-color-accent)"><title>net: $5800</title></rect><line x1="263.87" y1="47.16" x2="290.8" y2="47.16" stroke="var(--ak-color-line-strong)" stroke-width="1" stroke-dasharray="2 2"/><text x="243.67" y="44.16" text-anchor="middle" fill="var(--ak-color-ink)" font-size="10">$5800</text><text x="243.67" y="166" text-anchor="middle" fill="var(--ak-color-ink-muted)" font-size="10">net</text><rect x="290.8