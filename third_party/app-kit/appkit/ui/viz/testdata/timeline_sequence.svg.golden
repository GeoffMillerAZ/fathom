<svg xmlns="http://www.w3.org/2000/svg" width="560" height="61" role="img" aria-label="timeline" viewBox="0 0 560 61"><title>timeline</title><rect x="14" y="16" width="354.67" height="14" rx="3" fill="var(--ak-color-accent-soft)"><title>pleadings (5 Jan 2026 – 3 Feb 2026)</title></rect><text x="372.67" y="23" dominant-baseline="middle" fill="var(--ak-color-ink-muted)" font-size="10">pleadings</text><line x1="14" y1="45" x2="546" y2="45" stroke="var(--ak-color-line-strong)" stroke-width="1.5"/><line x1="446.69" y1="16" x2="446.69" y2="50" stroke="var(--ak-color-focus)" stroke-width="1" stroke-dasharray="3 2"/><text x="446.69" y="11" text-anchor="middle" fill="var(--ak-color-focus)" font-size="10">today</text><circle cx="14" cy="45" r="4" fill="var(--ak-color-accent)" stroke="var(--ak-color-surface)" stroke-width="1.5"><title>filed (5 Jan 2026)</title></circle><circle cx="191.33" cy="45" r="4" fill="var(--ak-color-info)" stroke="var(--ak-color-surface)" stroke-width="1.5"><title>served (20 Jan 2026)</title></circle><circle cx="368.67" cy="45" r="4" fill="var(--ak-color-positive)" stroke="var(--ak-color-surface)" stroke-width="1.5"><title>answered (3 Feb 2026)</title></circle><circle cx="546" cy="45" r="4" fill="var(--ak-color-danger)" stroke="var(--ak-color-surface)" stroke-width="1.5"><title>hearing (30 Nov 2026)</title></circle><text x="14" y="58" fill="var(--ak-color-ink-faint)" font-size="10">5 Jan 2026</text><text x="546" y="58" text-anchor="end" fill="var(--ak-color-ink-faint)" font-size="10">30 Nov 2026</text></svg>