<svg xmlns="http://www.w3.org/2000/svg" width="775" height="152" role="img" aria-label="indexing pipeline" viewBox="0 0 775 152"><title>indexing pipeline</title><desc>Stages of one ingest run. 7 nodes and 8 edges in 5 columns. 1 edge closing a cycle is drawn right to left. 1 duplicate edge was merged.</desc><g aria-hidden="true"><path d="M123 34 C155 34 155 62 180 62" fill="none" stroke="var(--ak-color-ink-muted)" stroke-width="1.5"/><path d="M187 62 L180 58.5 L180 65.5 Z" fill="var(--ak-color-ink-muted)"/><path d="M123 90 C394.5 90 394.5 101 659 101" fill="none" stroke="var(--ak-color-ink-muted)" stroke-width="1.5"/><path d="M666 101 L659 97.5 L659 104.5 Z" fill="var(--ak-color-ink-muted)"/><path d="M259 51 C291 51 291 62 316 62" fill="none" stroke="var(--ak-color-ink-muted)" stroke-width="1.5"/><path d="M323 62 L316 58.5 L316 65.5 Z" fill="var(--ak-color-ink-muted)"/><path d="M259 73 C385.5 73 385.5 51 505 51" fill="none" stroke="var(--ak-color-ink-muted)" stroke-width="1.5" stroke-dasharray="5 4"/><path d="M512 51 L505 47.5 L505 54.5 Z" fill="var(--ak-color-ink-muted)"/><path d="M602 51 C634 51 634 34 659 34" fill="none" stroke="var(--ak-color-ink-muted)" stroke-width="1.5"/><path d="M666 34 L659 30.5 L659 37.5 Z" fill="var(--ak-color-ink-muted)"/><path d="M666 39 C394.5 39 394.5 39 130 39" fill="none" stroke="var(--ak-color-ink-muted)" stroke-width="1.5" stroke-dasharray="5 4"/><path d="M123 39 L130 35.5 L130 42.5 Z" fill="var(--ak-color-ink-muted)"/><path d="M448 62 C480 62 480 73 505 73" fill="none" stroke="var(--ak-color-accent)" stroke-width="2.5"/><path d="M512 73 L505 69.5 L505 76.5 Z" fill="var(--ak-color-accent)"/><path d="M602 73 C634 73 634 79 659 79" fill="none" stroke="var(--ak-color-accent)" stroke-width="2.5"/><path d="M666 79 L659 75.5 L659 82.5 Z" fill="var(--ak-color-accent)"/><g data-node-id="fetch"><title>fetch sources</title><rect x="12" y="12" width="111" height="44" rx="6" fill="var(--ak-color-surface-raised)" stroke="var(--ak-color-line-strong)" stroke-width="1"/><text x="22" y="34" dominant-baseline="middle" font-size="11" fill="var(--ak-color-ink)">fetch sources</text></g><g data-node-id="lint"><title>lint config</title><rect x="12" y="68" width="111" height="44" rx="6" fill="var(--ak-color-surface-raised)" stroke="var(--ak-color-line-strong)" stroke-width="1"/><text x="22" y="90" dominant-baseline="middle" font-size="11" fill="var(--ak-color-ink)">lint config</text></g><g data-node-id="parse"><title>parse</title><rect x="187" y="40" width="72" height="44" rx="6" fill="var(--ak-color-surface-raised)" stroke="var(--ak-color-line-strong)" stroke-width="1"/><text x="197" y="62" dominant-baseline="middle" font-size="11" fill="var(--ak-color-ink)">parse</text></g><g data-node-id="extract"><title>extract symbols — dialect packs</title><rect x="323" y="40" width="125" height="44" rx="6" fill="var(--ak-color-surface-raised)" stroke="var(--ak-color-line-strong)" stroke-width="1"/><text x="333" y="56" dominant-baseline="middle" font-size="11" fill="var(--ak-color-ink)">extract symbols</text><text x="333" y="70" dominant-baseline="middle" font-size="10" fill="var(--ak-color-ink-muted)">dialect packs</text></g><g data-node-id="fuse"><title>fuse edges</title><rect x="512" y="40" width="90" height="44" rx="6" fill="var(--ak-color-surface-raised)" stroke="var(--ak-color-line-strong)" stroke-width="1"/><text x="522" y="62" dominant-baseline="middle" font-size="11" fill="var(--ak-color-ink)">fuse edges</text></g><g data-node-id="retry"><title>retry</title><rect x="666" y="12" width="97" height="44" rx="6" fill="var(--ak-color-surface-raised)" stroke="var(--ak-color-line-strong)" stroke-width="1"/><text x="676" y="34" dominant-baseline="middle" font-size="11" fill="var(--ak-color-ink)">retry</text></g><g data-node-id="index"><title>write index</title><a href="/stages/index" tabindex="-1"><rect x="666" y="68" width="97" height="44" rx="6" fill="var(--ak-color-surface-raised)" stroke="var(--ak-color-line-strong)" stroke-width="1"/><text x="676" y="90" dominant-baseline="middle" font-size="11" fill="var(--ak-color-ink)">write index</text></a></g><path d="M12 130 H36" stroke="var(--ak-color-ink-muted)" stroke-width="1.5"/><text x="42" y="130" dominant-baseline="middle" font-size="11" fill="var(--ak-color-ink-muted)">Solid</text><path d="M95 130 H119" stroke="var(--ak-color-ink-muted)" stroke-width="1.5" stroke-dasharray="5 4"/><text x="125" y="130" dominant-baseline="middle" font-size="11" fill="var(--ak-color-ink-muted)">Optional</text><path d="M199 130 H223" stroke="var(--ak-color-accent)" stroke-width="2.5"/><text x="229" y="130" dominant-baseline="middle" font-size="11" fill="var(--ak-color-ink-muted)">Emphasized</text></g></svg>